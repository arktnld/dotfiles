* {
    /* Colors */
    bg0:     #1e1e2e;
    bg1:     #313244;
    bg2:     #45475a;
    fg:      #cdd6f4;
    accent:  #89b4fa;
    urgent:  #f38ba8;
    success: #a6e3a1;

    background-color: transparent;
    text-color: @fg;

    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor:   center;
    fullscreen: false;
    width:    45%;
    height:   auto;
    max-width: 800px;

    background-color: @bg0;
    border:           3px;
    border-color:     @accent;
    border-radius:    12px;
    padding:          20px;
}

mainbox {
    spacing: 15px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing:  10px;
    children: [ prompt, entry ];

    border:        2px;
    border-color:  @bg2;
    border-radius: 8px;
    padding:       12px;
    background-color: @bg1;
}

prompt {
    text-color: @accent;
    font:       "Noto Sans Bold 12";
}

entry {
    text-color: @fg;
    placeholder-color: @bg2;
    placeholder: "Type to search...";
}

listview {
    lines:   8;
    columns: 1;
    spacing: 8px;
    scrollbar: true;
}

element {
    spacing:      10px;
    padding:      10px;
    border-radius: 8px;
    background-color: transparent;
}

element normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.active {
    background-color: @bg2;
    text-color:       @accent;
}

element selected {
    background-color: @accent;
    text-color:       @bg0;
    border-radius:    8px;
}

element selected.active {
    background-color: @accent;
    text-color:       @bg0;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 32px;
    border-radius: 4px;
}

scrollbar {
    width:        8px;
    handle-width: 8px;
    background-color: @bg1;
    handle-color:     @accent;
    border-radius:    4px;
}
