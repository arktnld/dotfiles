    def keypress(self, size, key):
        """Handler de teclas"""
        # Vim-style navigation
        if key == 'j':
            key = 'down'
        elif key == 'k':
            key = 'up'

        if key == 'esc':
            self.app.pop_screen()
            return None

        return super().keypress(size, key)


# ============================================================================
# ClickUpImportScreen - Tela de importação do ClickUp
# ============================================================================

class ClickUpTaskRow(urwid.WidgetWrap):
    """Widget para exibir uma task do ClickUp na lista de importação"""

    def __init__(self, clickup_task, is_imported=False):
        self.clickup_task = clickup_task
        self.is_imported = is_imported
        self.selected = False

        # Extrair info
        task_id = clickup_task.get("id", "")
        name = clickup_task.get("name", "Sem nome")[:45]
        status = clickup_task.get("status", {}).get("status", "?")[:10]
        priority = clickup_task.get("priority", {})
        priority_str = (priority.get("priority", "-") if priority else "-")[:1].upper()
        list_name = clickup_task.get("list", {}).get("name", "")[:15]

        # Indicador de importado
        imported_mark = "✓" if is_imported else " "

        # Montar linha
        line = f" [{imported_mark}] {name:<45} │ {status:<10} │ {priority_str} │ {list_name}"

        text_widget = urwid.Text(line)
        attr = 'dimmed' if is_imported else 'task_row'
        attr_map = urwid.AttrMap(text_widget, attr, focus_map='task_row_focus')

        super().__init__(attr_map)

    def selectable(self):
        return True

    def keypress(self, size, key):
        return key


class ClickUpImportScreen(urwid.WidgetWrap):
    """Tela para importar tasks do ClickUp"""

    def __init__(self, app):
        self.app = app
        self.clickup_tasks = []
        self.task_widgets = []
        self.api = None
        self.loading = False
        self.error_message = None

        # Carregar config
        config = ClickUpAPI.load_config()
        self.api_token = config.get("clickup_api_token", "")

        # Header
        header_text = urwid.Text(
            "━━━ 📥 IMPORTAR DO CLICKUP ━━━ [ESC]Voltar [Enter]Importar [r]Refresh [t]Token [c]Closed ━━━",
            align='center'
        )
        self.header = urwid.AttrMap(header_text, 'header')

        # Body - Lista de tasks
        self.list_walker = urwid.SimpleFocusListWalker([])
        self.listbox = urwid.ListBox(self.list_walker)
        self.list_box = urwid.LineBox(self.listbox, title="Tasks")

        # Footer
        self.footer_text = urwid.Text("", align='center')
        self.footer = urwid.AttrMap(self.footer_text, 'footer')

        # Frame
        self.frame = urwid.Frame(
            header=self.header,
            body=self.list_box,
            footer=self.footer
        )

        super().__init__(self.frame)

        # Carregar tasks se tiver token
        if self.api_token:
            self._show_loading()
            # Agendar carregamento para depois do loop iniciar
            self._load_tasks()
        else:
            self._show_token_prompt()

    def _show_loading(self):
        """Mostra mensagem de carregamento"""
        self.list_walker.clear()
        self.list_walker.append(urwid.Text(('text', "\n\n   ⏳ Carregando tasks do ClickUp..."), align='center'))
        self.footer_text.set_text("Aguarde...")

    def _show_token_prompt(self):
        """Mostra prompt para inserir token"""
        self.list_walker.clear()
        self.list_walker.append(urwid.Text(('title', "\n\n   🔑 API Token não configurado"), align='center'))
        self.list_walker.append(urwid.Text(('text', "\n   Pressione [t] para configurar seu token do ClickUp"), align='center'))
        self.list_walker.append(urwid.Text(('secondary', "\n   Para obter: ClickUp > Settings > Apps > API Token"), align='center'))
        self.footer_text.set_text("[t] Configurar Token │ [ESC] Voltar")

    def _show_error(self, message):
        """Mostra mensagem de erro"""
        self.list_walker.clear()
        self.list_walker.append(urwid.Text(('error', f"\n\n   ❌ Erro: {message}"), align='center'))
        self.list_walker.append(urwid.Text(('text', "\n   [r] Tentar novamente │ [t] Reconfigurar token"), align='center'))
        self.footer_text.set_text("[r] Retry │ [t] Token │ [ESC] Voltar")

    def _load_tasks(self, include_closed=False):
        """Carrega tasks do ClickUp"""
        self.loading = True
        self._show_loading()

        try:
            self.api = ClickUpAPI(self.api_token)

            # Verificar autenticação
            user_result = self.api.get_user()
            if "error" in user_result:
                self._show_error(user_result["error"])
                self.loading = False
                return

            # Buscar tasks
            self.clickup_tasks = self.api.get_all_my_tasks(include_closed=include_closed)

            if not self.clickup_tasks:
                self.list_walker.clear()
                self.list_walker.append(urwid.Text(('text', "\n\n   📭 Nenhuma task encontrada atribuída a você"), align='center'))
                self.footer_text.set_text(f"0 tasks │ [c] Incluir fechadas │ [r] Refresh │ [ESC] Voltar")
                self.loading = False
                return

            # Pegar IDs já importados
            imported_ids = set()
            for task in self.app.state.tasks:
                if task.get("clickup_id"):
                    imported_ids.add(task["clickup_id"])

            # Montar lista
            self.list_walker.clear()
            self.task_widgets = []

            # Agrupar tasks por data
            today = datetime.now().date()
            tomorrow = today + timedelta(days=1)

            def get_due_date(task):
                due = task.get("due_date")
                if due:
                    try:
                        return datetime.fromtimestamp(int(due) / 1000).date()
                    except:
                        pass
                return None

            # Separar tasks com e sem data
            tasks_with_date = []
            tasks_without_date = []

            for ct in self.clickup_tasks:
                due = get_due_date(ct)
                if due:
                    tasks_with_date.append((due, ct))
                else:
                    tasks_without_date.append(ct)

            # Ordenar por data
            tasks_with_date.sort(key=lambda x: x[0])

            # Renderizar tasks agrupadas por dia
            current_day = None

            for due_date, ct in tasks_with_date:
                # Separador de dia
                if due_date != current_day:
                    current_day = due_date

                    if due_date < today:
                        day_label = f"⚠️  ATRASADO - {due_date.strftime('%d/%m %A').upper()}"
                        day_style = 'error'
                    elif due_date == today:
                        day_label = "📍 HOJE"
                        day_style = 'warning'
                    elif due_date == tomorrow:
                        day_label = "📆 AMANHÃ"
                        day_style = 'success'
                    else:
                        day_label = f"📅 {due_date.strftime('%d/%m %A').upper()}"
                        day_style = 'subtitle'

                    self.list_walker.append(urwid.Divider())
                    separator = urwid.AttrMap(
                        urwid.Text(f" {day_label} ", align='left'),
                        day_style
                    )
                    self.list_walker.append(separator)
                    self.list_walker.append(urwid.Divider('─'))

                is_imported = ct.get("id") in imported_ids
                row = ClickUpTaskRow(ct, is_imported)
                self.task_widgets.append(row)
                self.list_walker.append(row)

            # Tasks sem data
            if tasks_without_date:
                self.list_walker.append(urwid.Divider())
                separator = urwid.AttrMap(
                    urwid.Text(" 📋 SEM DATA ", align='left'),
                    'dimmed'
                )
                self.list_walker.append(separator)
                self.list_walker.append(urwid.Divider('─'))

                for ct in tasks_without_date:
                    is_imported = ct.get("id") in imported_ids
                    row = ClickUpTaskRow(ct, is_imported)
                    self.task_widgets.append(row)
                    self.list_walker.append(row)

            imported_count = len(imported_ids & {t.get("id") for t in self.clickup_tasks})
            total = len(self.clickup_tasks)
            self.footer_text.set_text(
                f"{total} tasks ({imported_count} importadas) │ [Enter] Importar │ [c] Closed │ [r] Refresh │ [ESC] Voltar"
            )

        except Exception as e:
            self._show_error(str(e))

        self.loading = False

    def _import_selected_task(self):
        """Importa a task selecionada"""
        focus_widget = self.listbox.focus
        if not isinstance(focus_widget, ClickUpTaskRow):
            return

        if focus_widget.is_imported:
            # Já importada, mostrar mensagem
            self.footer_text.set_text("⚠️  Task já foi importada anteriormente!")
            return

        ct = focus_widget.clickup_task

        # Mapear campos
        description = ct.get("name", "Sem nome")
        priority = ClickUpAPI.map_priority(ct.get("priority"))
        status = ClickUpAPI.map_status(ct.get("status"))
        company = ClickUpAPI.extract_company(ct)
        clickup_id = ct.get("id")
        clickup_url = ct.get("url", "")

        # Due date (timestamp em ms do ClickUp)
        due_date = ct.get("due_date")
        due_date_iso = None
        if due_date:
            try:
                due_date_iso = datetime.fromtimestamp(int(due_date) / 1000).isoformat()
            except:
                pass

        # Nome da lista do ClickUp
        clickup_list = ct.get("list", {}).get("name", "")

        # Criar task
        task = {
            'id': self.app.state.get_next_id(),
            'description': description,
            'status': status,
            'priority': priority,
            'who': '',
            'category': 'other',
            'company': company,
            'comments': [],
            'clickup_id': clickup_id,
            'clickup_url': clickup_url,
            'clickup_list': clickup_list,
            'due_date': due_date_iso,
            'created': datetime.now().isoformat(),
            'updated': datetime.now().isoformat()
        }

        self.app.state.tasks.append(task)
        self.app.state.save_tasks()

        # Atualizar visual
        focus_widget.is_imported = True
        focus_widget._w.set_attr_map({None: 'dimmed'})

        # Atualizar texto do widget
        name = ct.get("name", "Sem nome")[:50]
        status_str = ct.get("status", {}).get("status", "?")
        priority_obj = ct.get("priority", {})
        priority_str = priority_obj.get("priority", "none") if priority_obj else "none"
        list_name = ct.get("list", {}).get("name", "")
        folder_name = ct.get("folder", {}).get("name", "")
        line = f"[✓] {name:<50} │ {status_str:<12} │ {priority_str:<6} │ {list_name or folder_name}"
        focus_widget._w.base_widget.set_text(line)

        self.footer_text.set_text(f"✅ Task importada! │ [Enter] Importar │ [ESC] Voltar")

    def _prompt_token(self):
        """Abre dialog para inserir token"""
        edit = urwid.Edit("API Token: ", edit_text=self.api_token)

        def on_ok(button):
            new_token = edit.get_edit_text().strip()
            if new_token:
                self.api_token = new_token
                config = ClickUpAPI.load_config()
                config["clickup_api_token"] = new_token
                ClickUpAPI.save_config(config)
                self.app.close_overlay()
                self._load_tasks()
            else:
                self.app.close_overlay()

        def on_cancel(button):
            self.app.close_overlay()

        ok_btn = urwid.Button("OK", on_press=on_ok)
        cancel_btn = urwid.Button("Cancel", on_press=on_cancel)

        button_row = urwid.Columns([
            urwid.AttrMap(ok_btn, 'button', focus_map='button_focus'),
            urwid.AttrMap(cancel_btn, 'button', focus_map='button_focus'),
        ], dividechars=2)

        content = [
            urwid.Text("🔑 Configurar API Token do ClickUp\n", align='center'),
            urwid.Text("Obtenha em: ClickUp > Settings > Apps > API Token\n", align='center'),
            urwid.Divider(),
            urwid.AttrMap(edit, None, focus_map='focus'),
            urwid.Divider(),
            button_row,
        ]

        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(content))
        box = urwid.LineBox(listbox, title="API Token")
        dialog = urwid.AttrMap(box, 'dialog_bg')

        self.app.show_overlay(dialog, width=('relative', 70), height=('relative', 40))

    def keypress(self, size, key):
        """Handler de teclas"""
        if key == 'j':
            key = 'down'
        elif key == 'k':
            key = 'up'

        if key == 'esc':
            self.app.pop_screen()
            return None
        elif key == 't':
            self._prompt_token()
            return None
        elif key == 'r':
            if self.api_token:
                self._load_tasks()
            return None
        elif key == 'c':
            if self.api_token:
                self._load_tasks(include_closed=True)
            return None
        elif key == 'enter':
            self._import_selected_task()
            return None

        return super().keypress(size, key)


# ============================================================================
# QuickTasksApp - Aplicação principal com MainLoop
# ============================================================================

class LoadingScreen(urwid.WidgetWrap):
    """Tela de carregamento"""

    def __init__(self, status="Carregando..."):
        self.status_text = urwid.Text(('title', status), align='center')

        content = urwid.Pile([
            urwid.Text(""),
            urwid.Text(('header', "  ⚡ QuickTasks  "), align='center'),
            urwid.Text(""),
            self.status_text,
            urwid.Text(""),
        ])

        filler = urwid.Filler(content, valign='middle')
        super().__init__(filler)

    def set_status(self, status):
        self.status_text.set_text(('dimmed', status))


class QuickTasksApp:
    """Aplicação TUI principal"""

    def __init__(self):
        self.state = None
        self.main_screen = None
        self.screen_stack = []
        self.loop = None

        # Criar palette
        self.palette = create_palette()

        # Tela de loading inicial
        self.loading_screen = LoadingScreen("Iniciando...")
        self.main_widget = urwid.WidgetPlaceholder(self.loading_screen)

    def _load_data(self, loop, data):
        """Carrega dados em background"""
        # Carregar tasks
        self.loading_screen.set_status("Carregando tarefas...")
        loop.draw_screen()

        self.state = AppState()
        self.state.load_tasks()

        # Carregar tasks do ClickUp (uma vez, para sync e painel)
        self.loading_screen.set_status("Sincronizando ClickUp...")
        loop.draw_screen()

        self.clickup_tasks = load_clickup_tasks()
        sync_clickup_due_dates(self.state, self.clickup_tasks)

        # Carregar eventos do Google Calendar
        self.loading_screen.set_status("Carregando agenda...")
        loop.draw_screen()

        self.state.load_events()

        # Limpar notificações expiradas
        self.loading_screen.set_status("Limpando notificações...")
        loop.draw_screen()

        cleanup_expired_notifications()

        # Criar tela principal
        self.loading_screen.set_status("Pronto!")
        loop.draw_screen()

        self.main_screen = MainScreen(self)
        self.main_widget.original_widget = self.main_screen
        self.screen_stack = [self.main_screen]

    def run(self):
        """Inicia o MainLoop"""
        # Criar o loop principal
        self.loop = urwid.MainLoop(
            self.main_widget,
            palette=self.palette,
            unhandled_input=self.unhandled_input,
            handle_mouse=False
        )

        # Agendar carregamento de dados após o loop iniciar
        self.loop.set_alarm_in(0.01, self._load_data)

        # Executar
        try:
            self.loop.run()
        except KeyboardInterrupt:
            # Ctrl+C: sair gracefully
            self.quit()

    def unhandled_input(self, key):
        """Handler para teclas não tratadas (atalhos globais)"""
        if key in ('q', 'Q'):
            # Tecla 'q' para quit
            self.quit()
        elif key in ('f1', '?'):
            # F1 ou '?' para help
            help_screen = HelpScreen(self)
            self.push_screen(help_screen)

    def push_screen(self, screen):
        """Empilha uma nova tela (navega para ela)"""
        self.screen_stack.append(screen)
        self.main_widget.original_widget = screen

    def pop_screen(self):
        """Volta para a tela anterior"""
        if len(self.screen_stack) > 1:
            self.screen_stack.pop()
            self.main_widget.original_widget = self.screen_stack[-1]

            # Refresh da tela principal se voltando para ela
            if isinstance(self.screen_stack[-1], MainScreen):
                self.screen_stack[-1].update_header()
                self.screen_stack[-1].refresh_task_list()

    def show_overlay(self, dialog_widget, width=('relative', 50), height=('relative', 50)):
        """Mostra um dialog como overlay sobre a tela atual"""
        current_screen = self.screen_stack[-1]

        overlay = urwid.Overlay(
            dialog_widget,
            current_screen,
            align='center', width=width,
            valign='middle', height=height
        )

        self.main_widget.original_widget = overlay

    def close_overlay(self):
        """Fecha o overlay e volta para a tela atual"""
        self.main_widget.original_widget = self.screen_stack[-1]

    def quit(self):
        """Sai da aplicação"""
        # Salvar se houver mudanças
        if self.state.dirty:
            self.state.save_tasks()

        raise urwid.ExitMainLoop()


# ============================================================================
# Entry point
# ============================================================================

if __name__ == '__main__':
    app = QuickTasksApp()
    app.run()
