            if rb.get_state():
                self.app.state.update_task(self.task['id'], priority=priority_key)
                self.app.state.save_tasks()
                break

        self.on_close()

    def on_cancel(self, button):
        """Fechar sem salvar"""
        self.on_close()

    def keypress(self, size, key):
        """Esc para fechar"""
        if key == 'esc':
            self.on_cancel(None)
            return None
        return super().keypress(size, key)


class CommentDialog(urwid.WidgetWrap):
    """Dialog para adicionar comentário"""

    def __init__(self, app, task, on_close):
        self.app = app
        self.task = task
        self.on_close = on_close

        # Edit widget para o comentário
        self.edit = urwid.Edit(multiline=True)

        # Botões de ação
        ok_btn = urwid.Button("Add Comment", on_press=self.on_ok)
        cancel_btn = urwid.Button("Cancel", on_press=self.on_cancel)

        button_row = urwid.Columns([
            urwid.AttrMap(ok_btn, 'button', focus_map='button_focus'),
            urwid.AttrMap(cancel_btn, 'button', focus_map='button_focus'),
        ], dividechars=2)

        # Montar dialog
        content = [
            urwid.Text(f"Adicionar comentário à task #{task['id']}:\n", align='center'),
            urwid.Divider(),
            urwid.AttrMap(self.edit, None, focus_map='focus'),
            urwid.Divider(),
            button_row,
        ]

        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(content))
        box = urwid.LineBox(listbox, title="Comentário")
        dialog = urwid.AttrMap(box, 'dialog_bg')

        super().__init__(dialog)

    def on_ok(self, button):
        """Salvar comentário"""
        comment_text = self.edit.get_edit_text().strip()
        if not comment_text:
            # Mostrar erro
            error_dialog = MessageDialog(
                "Erro de Validação",
                "O comentário não pode estar vazio.",
                on_ok=lambda: self.app.close_overlay(),
                dialog_type='error'
            )
            # Fechar este dialog primeiro, depois mostrar erro
            self.on_close()
            self.app.show_overlay(error_dialog, width=('relative', 50), height=('relative', 25))
            return

        self.app.state.add_comment(self.task['id'], comment_text)
        self.app.state.save_tasks()
        self.on_close()

    def on_cancel(self, button):
        """Fechar sem salvar"""
        self.on_close()

    def keypress(self, size, key):
        """Esc para fechar"""
        if key == 'esc':
            self.on_cancel(None)
            return None
        return super().keypress(size, key)


class ConfirmDialog(urwid.WidgetWrap):
    """Dialog genérico de confirmação"""

    def __init__(self, title, message, on_yes, on_no):
        self.on_yes_callback = on_yes
        self.on_no_callback = on_no

        # Mensagem
        text = urwid.Text(message, align='center')

        # Botões
        yes_btn = urwid.Button("Yes", on_press=self.on_yes)
        no_btn = urwid.Button("No", on_press=self.on_no)

        button_row = urwid.Columns([
            urwid.AttrMap(yes_btn, 'button', focus_map='button_focus'),
            urwid.AttrMap(no_btn, 'button', focus_map='button_focus'),
        ], dividechars=2)

        # Montar dialog
        content = [
            text,
            urwid.Divider(),
            button_row,
        ]

        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(content))
        box = urwid.LineBox(listbox, title=title)
        dialog = urwid.AttrMap(box, 'dialog_bg')

        super().__init__(dialog)

    def on_yes(self, button):
        """Confirmar"""
        self.on_yes_callback()

    def on_no(self, button):
        """Cancelar"""
        self.on_no_callback()

    def keypress(self, size, key):
        """Esc para cancelar"""
        if key == 'esc':
            self.on_no(None)
            return None
        return super().keypress(size, key)


class MessageDialog(urwid.WidgetWrap):
    """Dialog genérico para mensagens (erro, sucesso, info)"""

    def __init__(self, title, message, on_ok, dialog_type='info'):
        """
        dialog_type: 'error', 'success', 'info', 'warning'
        """
        self.on_ok_callback = on_ok

        # Ícone baseado no tipo
        icons = {
            'error': '❌',
            'success': '✅',
            'info': 'ℹ️ ',
            'warning': '⚠️ '
        }
        icon = icons.get(dialog_type, 'ℹ️ ')

        # Mensagem com ícone
        text = urwid.Text(f"{icon} {message}", align='center')

        # Botão OK
        ok_btn = urwid.Button("OK", on_press=self.on_ok)

        button_row = urwid.Columns([
            urwid.AttrMap(ok_btn, 'button', focus_map='button_focus'),
        ], dividechars=2)

        # Montar dialog
        content = [
            text,
            urwid.Divider(),
            button_row,
        ]

        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(content))
        box = urwid.LineBox(listbox, title=title)
        dialog = urwid.AttrMap(box, 'dialog_bg')

        super().__init__(dialog)

    def on_ok(self, button):
        """Fechar dialog"""
        self.on_ok_callback()

    def keypress(self, size, key):
        """Esc ou Enter para fechar"""
        if key in ('esc', 'enter'):
            self.on_ok(None)
            return None
        return super().keypress(size, key)


# ============================================================================
# AddTodoDialog - Dialog para adicionar TODO
# ============================================================================

class AddTodoDialog(urwid.WidgetWrap):
    """Dialog para adicionar novo TODO"""

    def __init__(self, app, task, on_close):
        self.app = app
        self.task = task
        self.on_close_callback = on_close

        # Campo de texto
        self.edit = urwid.Edit(caption="TODO: ", multiline=False)

        # Botões
        ok_btn = urwid.Button("Adicionar", on_press=self.on_ok)
        cancel_btn = urwid.Button("Cancelar", on_press=self.on_cancel)

        button_row = urwid.Columns([
            urwid.AttrMap(ok_btn, 'button', focus_map='button_focus'),
            urwid.AttrMap(cancel_btn, 'button', focus_map='button_focus'),
        ], dividechars=2)

        # Montar dialog
        content = [
            urwid.Text(f"Adicionar TODO à task #{task['id']}:\n", align='center'),
            urwid.Divider(),
            urwid.AttrMap(self.edit, None, focus_map='focus'),
            urwid.Divider(),
            button_row,
        ]

        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(content))
        box = urwid.LineBox(listbox, title="Novo TODO")
        dialog = urwid.AttrMap(box, 'dialog_bg')

        super().__init__(dialog)

    def on_ok(self, button):
        """Salvar TODO"""
        text = self.edit.get_edit_text().strip()
        if not text:
            # Validação: texto vazio
            error_dialog = MessageDialog(
                "Erro de Validação",
                "O TODO não pode estar vazio.",
                on_ok=lambda: self.app.close_overlay(),
                dialog_type='error'
            )
            self.on_close_callback()
            self.app.show_overlay(error_dialog, width=('relative', 50), height=('relative', 25))
            return

        self.app.state.add_todo(self.task['id'], text)
        self.app.state.save_tasks()
        self.on_close_callback()

    def on_cancel(self, button):
        """Fechar sem salvar"""
        self.on_close_callback()

    def keypress(self, size, key):
        """Esc para fechar"""
        if key == 'esc':
            self.on_cancel(None)
            return None
        return super().keypress(size, key)


# ============================================================================
# EditTodoDialog - Dialog para editar TODO
# ============================================================================

class EditTodoDialog(urwid.WidgetWrap):
    """Dialog para editar TODO existente"""

    def __init__(self, app, task, todo_index, on_close):
        self.app = app
        self.task = task
        self.todo_index = todo_index
        self.on_close_callback = on_close

        # Pegar texto atual
        current_text = task['todos'][todo_index]['text']

        # Campo de texto pre-preenchido
        self.edit = urwid.Edit(caption="TODO: ", edit_text=current_text, multiline=False)

        # Botões
        ok_btn = urwid.Button("Salvar", on_press=self.on_ok)
        cancel_btn = urwid.Button("Cancelar", on_press=self.on_cancel)

        button_row = urwid.Columns([
            urwid.AttrMap(ok_btn, 'button', focus_map='button_focus'),
            urwid.AttrMap(cancel_btn, 'button', focus_map='button_focus'),
        ], dividechars=2)

        # Montar dialog
        content = [
            urwid.Text(f"Editar TODO:\n", align='center'),
            urwid.Divider(),
            urwid.AttrMap(self.edit, None, focus_map='focus'),
            urwid.Divider(),
            button_row,
        ]

        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(content))
        box = urwid.LineBox(listbox, title="Editar TODO")
        dialog = urwid.AttrMap(box, 'dialog_bg')

        super().__init__(dialog)

    def on_ok(self, button):
        """Salvar alteração"""
        text = self.edit.get_edit_text().strip()
        if not text:
            # Validação
            error_dialog = MessageDialog(
                "Erro de Validação",
                "O TODO não pode estar vazio.",
                on_ok=lambda: self.app.close_overlay(),
                dialog_type='error'
            )
            self.on_close_callback()
            self.app.show_overlay(error_dialog, width=('relative', 50), height=('relative', 25))
            return

        self.app.state.update_todo(self.task['id'], self.todo_index, text)
        self.app.state.save_tasks()
        self.on_close_callback()

    def on_cancel(self, button):
        """Fechar sem salvar"""
        self.on_close_callback()

    def keypress(self, size, key):
        """Esc para fechar"""
        if key == 'esc':
            self.on_cancel(None)
            return None
        return super().keypress(size, key)


# ============================================================================
# TodoManageDialog - Dialog principal para gerenciar TODOs
# ============================================================================

class TodoManageDialog(urwid.WidgetWrap):
    """Dialog para gerenciar TODOs de uma task"""

    def __init__(self, app, task, on_close):
        self.app = app
        self.task = task
        self.on_close_callback = on_close

        # Lista de TODOs (mutável para rebuild)
        self.todos = task.get('todos', [])

        # Build content
        self.build_content()

        super().__init__(self.dialog)

    def build_content(self):
        """Constrói o conteúdo do dialog"""
        content = []

        # Header
        total = len(self.todos)
        done_count = sum(1 for t in self.todos if t['done'])
        content.append(urwid.Text(
            f"📋 TODOs da task #{self.task['id']} ({done_count}/{total} completos)\n",
            align='center'
        ))
        content.append(urwid.Divider())

        # Lista de TODOs (com checkbox)
        if self.todos:
            for idx, todo in enumerate(self.todos):
                checkbox = urwid.CheckBox(
                    todo['text'],
                    state=todo['done'],
                    on_state_change=lambda cb, new_state, i=idx: self.on_toggle(i, new_state)
                )

                # Botões de ação para cada TODO
                edit_btn = urwid.Button("✏️", on_press=lambda btn, i=idx: self.on_edit_todo(i))
                del_btn = urwid.Button("🗑️", on_press=lambda btn, i=idx: self.on_delete_todo(i))

                row = urwid.Columns([
                    ('weight', 3, urwid.AttrMap(checkbox, None, focus_map='focus')),
                    ('pack', urwid.AttrMap(edit_btn, 'button', focus_map='button_focus')),
                    ('pack', urwid.AttrMap(del_btn, 'button', focus_map='button_focus')),
                ], dividechars=1)

                content.append(row)
                content.append(urwid.Divider())
        else:
            content.append(urwid.Text("(Nenhum TODO ainda)", align='center'))
            content.append(urwid.Divider())

        # Botões principais
        add_btn = urwid.Button("➕ Adicionar TODO", on_press=self.on_add_todo)
        close_btn = urwid.Button("✅ Fechar", on_press=self.on_close)

        button_row = urwid.Columns([
            urwid.AttrMap(add_btn, 'button', focus_map='button_focus'),
            urwid.AttrMap(close_btn, 'button', focus_map='button_focus'),
        ], dividechars=2)

        content.append(button_row)

        # ListBox com todo o conteúdo
        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(content))
        box = urwid.LineBox(listbox, title="Gerenciar TODOs")
        self.dialog = urwid.AttrMap(box, 'dialog_bg')

    def on_toggle(self, idx, new_state):
        """Toggle TODO done/not done"""
        self.app.state.toggle_todo(self.task['id'], idx)
        self.app.state.save_tasks()
        # Reload task
        self.task = self.app.state.get_task(self.task['id'])
        self.todos = self.task.get('todos', [])
        # Rebuild
        self.build_content()
        self._w = self.dialog

    def on_add_todo(self, button):
        """Abrir dialog para adicionar novo TODO"""
        def on_add_close():
            self.app.close_overlay()
            # Reload e rebuild
            self.task = self.app.state.get_task(self.task['id'])
            self.todos = self.task.get('todos', [])
            self.build_content()
            self._w = self.dialog
            # Re-show este dialog
            self.app.show_overlay(self)

        add_dialog = AddTodoDialog(self.app, self.task, on_add_close)
        self.app.show_overlay(add_dialog, width=('relative', 60), height=('relative', 30))

    def on_edit_todo(self, idx):
        """Editar texto de um TODO"""
        def on_edit_close():
            self.app.close_overlay()
            # Reload e rebuild
            self.task = self.app.state.get_task(self.task['id'])
            self.todos = self.task.get('todos', [])
            self.build_content()
            self._w = self.dialog
            # Re-show este dialog
            self.app.show_overlay(self)

        edit_dialog = EditTodoDialog(self.app, self.task, idx, on_edit_close)
        self.app.show_overlay(edit_dialog, width=('relative', 60), height=('relative', 30))

    def on_delete_todo(self, idx):
        """Deletar TODO com confirmação"""
        todo_text = self.todos[idx]['text']

        def on_yes():
            self.app.state.delete_todo(self.task['id'], idx)
            self.app.state.save_tasks()
            self.app.close_overlay()
            # Reload e rebuild
            self.task = self.app.state.get_task(self.task['id'])
            self.todos = self.task.get('todos', [])
            self.build_content()
            self._w = self.dialog
            # Re-show este dialog
            self.app.show_overlay(self)

        def on_no():
            self.app.close_overlay()
            # Re-show este dialog
            self.app.show_overlay(self)

        confirm = ConfirmDialog(
            "Deletar TODO",
            f"Deletar TODO: '{todo_text}'?",
            on_yes=on_yes,
            on_no=on_no
        )
        self.app.show_overlay(confirm, width=('relative', 50), height=('relative', 25))

    def on_close(self, button=None):
        """Fechar dialog"""
        self.on_close_callback()

    def keypress(self, size, key):
        """Esc para fechar"""
        if key == 'esc':
            self.on_close()
            return None
        return super().keypress(size, key)


# ============================================================================
# TaskEditScreen - Formulário de edição de task
# ============================================================================

class TaskEditScreen(urwid.WidgetWrap):
    """Tela para editar ou criar uma task"""

    def __init__(self, app, task=None):
        self.app = app
        self.task = task  # None = nova task
        self.is_new = (task is None)

        # Campos do formulário
        self.description_edit = urwid.Edit(
            "Descrição:\n",
            edit_text=task['description'] if task else "",
            multiline=True
        )

        self.who_edit = urwid.Edit(
            "Quem pediu: ",
            edit_text=task.get('who', '') if task else ""
        )

        self.company_edit = urwid.Edit(
            "Empresa: ",
            edit_text=task.get('company', '') if task else ""
        )

        # RadioButtons para status (só na criação de nova task)
        self.status_group = []
        self.status_buttons = {}
        status_widgets = []

        if self.is_new:
            status_widgets.append(urwid.Text("Status:"))
            for status_key, status_info in STATUS.items():
                # Não mostrar 'finished' na criação
                if status_key == 'finished':
                    continue
                selected = (status_key == 'todo')  # Default: todo
                rb = urwid.RadioButton(
                    self.status_group,
                    f"{status_info['emoji']} {status_info['label']}",
                    state=selected
                )
                self.status_buttons[status_key] = rb
                status_widgets.append(urwid.AttrMap(rb, None, focus_map='focus'))
            status_widgets.append(urwid.Divider())

        # RadioButtons para categoria
        self.category_group = []
        self.category_buttons = {}
        category_widgets = [urwid.Text("Categoria:")]

        for cat_key, cat_info in CATEGORIES.items():
            selected = (task and task.get('category') == cat_key) or (not task and cat_key == 'other')
            rb = urwid.RadioButton(
                self.category_group,
                f"{cat_info['emoji']} {cat_info['label']}",
                state=selected
            )
            self.category_buttons[cat_key] = rb
            category_widgets.append(urwid.AttrMap(rb, None, focus_map='focus'))

        # RadioButtons para prioridade
        self.priority_group = []
        self.priority_buttons = {}
        priority_widgets = [urwid.Divider(), urwid.Text("Prioridade:")]

        for pri_key, pri_info in PRIORITY.items():
            selected = (task and task.get('priority') == pri_key) or (not task and pri_key == 'low')
            rb = urwid.RadioButton(
                self.priority_group,
                f"{pri_info['emoji']} {pri_key.upper()}",
                state=selected
            )
            self.priority_buttons[pri_key] = rb
            priority_widgets.append(urwid.AttrMap(rb, None, focus_map='focus'))

        # Botões
        save_btn = urwid.Button("Save", on_press=self.on_save)
        cancel_btn = urwid.Button("Cancel", on_press=self.on_cancel)

        buttons = urwid.Columns([
            urwid.AttrMap(save_btn, 'button', focus_map='button_focus'),
            urwid.AttrMap(cancel_btn, 'button', focus_map='button_focus'),
        ], dividechars=2)

        # Montar formulário
        form_widgets = [
            urwid.AttrMap(self.description_edit, None, focus_map='focus'),
            urwid.Divider(),
            urwid.AttrMap(self.who_edit, None, focus_map='focus'),
            urwid.AttrMap(self.company_edit, None, focus_map='focus'),
            urwid.Divider(),
            *status_widgets,
            *category_widgets,
            *priority_widgets,
            urwid.Divider(),
            buttons,
        ]

        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(form_widgets))

        # Header
        title = "━━━ ✨ NOVA TASK ━━━" if self.is_new else f"━━━ ✏️  EDITAR TASK #{task['id']} ━━━"
        header = urwid.AttrMap(urwid.Text(title, align='center'), 'header')

        # Footer
        footer_text = "━ [ESC]Cancel [Tab]Next [Shift+Tab]Previous [Enter]Save ━"
        footer = urwid.AttrMap(urwid.Text(footer_text, align='center'), 'footer')

        # Frame
        frame = urwid.Frame(
            header=header,
            body=listbox,
            footer=footer
        )

        super().__init__(frame)

    def get_selected_category(self):
        """Retorna a categoria selecionada"""
        for cat_key, rb in self.category_buttons.items():
            if rb.get_state():
                return cat_key
        return 'other'

    def get_selected_priority(self):
        """Retorna a prioridade selecionada"""
        for pri_key, rb in self.priority_buttons.items():
            if rb.get_state():
                return pri_key
        return 'low'

    def get_selected_status(self):
        """Retorna o status selecionado (para nova task)"""
        for status_key, rb in self.status_buttons.items():
            if rb.get_state():
                return status_key
        return 'todo'

    def on_save(self, button):
        """Salvar task"""
        description = self.description_edit.get_edit_text().strip()

        # Validação
        if not description:
            # Mostrar erro
            dialog = MessageDialog(
                "Erro de Validação",
                "A descrição da task não pode estar vazia.",
                on_ok=lambda: self.app.close_overlay(),
                dialog_type='error'
            )
            self.app.show_overlay(dialog, width=('relative', 50), height=('relative', 25))
            return

        who = self.who_edit.get_edit_text().strip()
        company = self.company_edit.get_edit_text().strip()
        category = self.get_selected_category()
        priority = self.get_selected_priority()

        if self.is_new:
            # Criar nova task
            status = self.get_selected_status()
            self.app.state.add_task(
                description=description,
                priority=priority,
                who=who,
                category=category,
                company=company,
                status=status
            )
        else:
            # Atualizar task existente
            self.app.state.update_task(
                self.task['id'],
                description=description,
                who=who,
                company=company,
                category=category,
                priority=priority
            )

        self.app.state.save_tasks()
        self.app.pop_screen()

    def on_cancel(self, button):
        """Cancelar e voltar"""
        self.app.pop_screen()

    def keypress(self, size, key):
        """Handler de teclas"""
        if key == 'esc':
            self.on_cancel(None)
            return None

        return super().keypress(size, key)


# ============================================================================
# TaskDetailScreen - Tela de detalhes de uma task
# ============================================================================

class TaskDetailScreen(urwid.WidgetWrap):
    """Tela mostrando todos os detalhes de uma task"""

    def __init__(self, app, task):
        self.app = app
        self.task = task

        # Criar conteúdo da tela
        content = self.build_content()

        # Header
        header_text = urwid.Text(f"━━━ 🔍 TASK #{task['id']} ━━━", align='center')
        header = urwid.AttrMap(header_text, 'header')

        # Footer com ações
        footer_text = urwid.Text(
            "━ [ESC]Back [e]Edit [c]Comment [s]Status [p]Priority [t]TODOs [d]Delete [↑↓jk]Scroll ━",
            align='center'
        )
        footer = urwid.AttrMap(footer_text, 'footer')

        # Frame
        frame = urwid.Frame(
            header=header,
            body=content,
            footer=footer
        )

        super().__init__(frame)

    def build_content(self):
        """Constrói o conteúdo da tela de detalhes"""
        task = self.task

        # Info básica
        status_info = STATUS[task['status']]
        priority_info = PRIORITY[task['priority']]
        category_info = CATEGORIES[task.get('category', 'other')]

        # Formatar timestamps
        created = datetime.fromisoformat(task['created']).strftime('%d/%m/%Y às %H:%M')
        updated = datetime.fromisoformat(task['updated']).strftime('%d/%m/%Y às %H:%M')

        # Visual clean - branco/cinza com bold para destaque e divisas
        lines = [
            urwid.Text([('label', "\nID: "), ('text_bold', f"{task['id']}")]),
            urwid.Divider('─'),
            urwid.Text([
                ('label', "Status: "),
                (f"status_{task['status']}", f"{status_info['emoji']} {status_info['label']}")
            ]),
            urwid.Text([
                ('label', "Prioridade: "),
                (f"priority_{task['priority']}", f"{priority_info['emoji']} {task['priority'].upper()}")
            ]),
            urwid.Text([
                ('label', "Categoria: "),
                ('text', f"{category_info['emoji']} {category_info['label']}")
            ]),
            urwid.Text([('label', "Descrição:")]),
            urwid.Text([('text', task['description'])]),
            urwid.Text([('label', "Quem pediu: "), ('text', task.get('who', 'Não informado'))]),
            urwid.Text([('label', "Empresa: "), ('text', task.get('company', 'Não informado'))]),
            urwid.Text([('secondary', f"Criada: {created}")]),
            urwid.Text([('secondary', f"Atualizada: {updated}")]),
        ]

        # Adicionar finished_at se existir
        if task.get('finished_at'):
            finished = datetime.fromisoformat(task['finished_at']).strftime('%d/%m/%Y às %H:%M')
            lines.append(urwid.Text(('success', f"Finalizada: {finished}")))

        # ClickUp info se existir
        if task.get('clickup_id'):
            lines.append(urwid.Divider('─'))
            lines.append(urwid.Text(('subtitle', "\n🔗 ClickUp")))
            lines.append(urwid.Text([('label', "ID: "), ('text', task['clickup_id'])]))
            if task.get('clickup_url'):
                lines.append(urwid.Text([('label', "URL: "), ('text', task['clickup_url'])]))

        # TODOs (antes dos comentários)
        todos = task.get('todos', [])
        if todos:
            total = len(todos)
            done_count = sum(1 for t in todos if t['done'])

            lines.append(urwid.Divider('─'))
            lines.append(urwid.Text(('subtitle', f"\n📋 TODOs ({done_count}/{total} completos)")))

            for idx, todo in enumerate(todos):
                checkbox = "[X]" if todo['done'] else "[ ]"
                style = 'dimmed' if todo['done'] else 'text'
                text = todo['text']
                lines.append(urwid.Text((style, f"  {checkbox} {text}")))

        # Comentários (depois dos TODOs) - ordem: mais recente primeiro
        if task.get('comments'):
            lines.append(urwid.Divider('─'))
            lines.append(urwid.Text(('subtitle', f"\n💬 Comentários ({len(task['comments'])})")))

            comments = task['comments']
            for i, comment in enumerate(reversed(comments), 1):
                timestamp = datetime.fromisoformat(comment['timestamp']).strftime('%d/%m/%Y %H:%M')
                lines.append(urwid.Text(('secondary', f"\n[{i}] {timestamp}")))
                lines.append(urwid.Text(('text', f"  {comment['text']}")))

        # Criar Pile com todas as linhas
        pile = urwid.Pile(lines)

        # Wrap em ListBox para permitir scroll
        listbox = urwid.ListBox(urwid.SimpleFocusListWalker([pile]))

        return listbox

    def keypress(self, size, key):
        """Handler de teclas"""
        # Vim-style navigation
        if key == 'j':
            key = 'down'
        elif key == 'k':
            key = 'up'

        if key == 'esc':
            # Voltar para MainScreen
            self.app.pop_screen()
            return None
        elif key == 'e':
            # Editar task
            edit_screen = TaskEditScreen(self.app, self.task)
            self.app.push_screen(edit_screen)
            return None
        elif key == 'c':
            # Adicionar comentário
            def on_close():
                self.app.close_overlay()
                # Refresh da tela (rebuild)
                self.task = self.app.state.get_task(self.task['id'])
                content = self.build_content()
                self._w.body = content

            dialog = CommentDialog(self.app, self.task, on_close)
            self.app.show_overlay(dialog)
            return None
        elif key == 's':
            # Mudar status
            def on_close():
                self.app.close_overlay()
                # Refresh da tela (rebuild)
                self.task = self.app.state.get_task(self.task['id'])
                content = self.build_content()
                self._w.body = content

            dialog = StatusDialog(self.app, self.task, on_close)
            self.app.show_overlay(dialog)
            return None
        elif key == 'p':
            # Mudar prioridade
            def on_close():
                self.app.close_overlay()
                # Refresh da tela (rebuild)
                self.task = self.app.state.get_task(self.task['id'])
                content = self.build_content()
                self._w.body = content

            dialog = PriorityDialog(self.app, self.task, on_close)
            self.app.show_overlay(dialog)
            return None
        elif key == 'd':
            # Deletar task com confirmação
            def on_yes():
                self.app.state.delete_task(self.task['id'])
                self.app.state.save_tasks()
                self.app.close_overlay()
                self.app.pop_screen()  # Volta ao MainScreen

            def on_no():
                self.app.close_overlay()

            dialog = ConfirmDialog(
                "Confirmar Exclusão",
                f"Deletar task #{self.task['id']}?\n\n{self.task['description'][:50]}...",
                on_yes=on_yes,
                on_no=on_no
            )
            self.app.show_overlay(dialog, width=('relative', 60), height=('relative', 30))
            return None
        elif key == 't':
            # Gerenciar TODOs
            def on_close():
                self.app.close_overlay()
                # Reload task
                self.task = self.app.state.get_task(self.task['id'])
                # Rebuild content
                content = self.build_content()
                self._w.body = content

            dialog = TodoManageDialog(self.app, self.task, on_close)
            self.app.show_overlay(dialog, width=('relative', 70), height=('relative', 60))
            return None

        return super().keypress(size, key)


# ============================================================================
# MetricsScreen - Tela de métricas e estatísticas
# ============================================================================

class MetricsScreen(urwid.WidgetWrap):
    """Tela de métricas com gráficos ASCII e estatísticas"""

    def __init__(self, app, days=30):
        self.app = app
        self.days = days

        # Header
        header_text = urwid.Text(
            ('header', f"━━━ 📊 MÉTRICAS (últimos {days} dias) ━━━ [7]7d [3]30d [9]90d [ESC]Voltar [↑↓jk]Scroll ━━━"),
            align='center'
        )
        header = urwid.AttrMap(header_text, 'header')

        # Body com todas as métricas
        body_content = self._build_metrics()
        body = urwid.ListBox(urwid.SimpleFocusListWalker(body_content))

        # Frame
        frame = urwid.Frame(header=header, body=body)
        super().__init__(frame)

    def _build_metrics(self):
        """Constrói todas as seções de métricas"""
        from collections import defaultdict

        tasks = self.app.state.tasks

        if not tasks:
            return [urwid.Text(('body', "\n\n   📭 Nenhuma tarefa cadastrada"), align='center')]

        now = datetime.now()
        cutoff = now - timedelta(days=self.days)

        # Filtra tarefas do período
        recent_tasks = [
            t for t in tasks
            if datetime.fromisoformat(t['created']) >= cutoff
        ]

        if not recent_tasks:
            return [urwid.Text(('body', f"\n\n   📭 Nenhuma tarefa nos últimos {self.days} dias"), align='center')]

        # Métricas gerais
        total = len(recent_tasks)
        completed = len([t for t in recent_tasks if t['status'] == 'done'])
        finished = len([t for t in recent_tasks if t['status'] == 'finished'])
        in_progress = len([t for t in recent_tasks if t['status'] == 'doing'])
        paused = len([t for t in recent_tasks if t['status'] == 'paused'])
        blocked = len([t for t in recent_tasks if t['status'] == 'blocked'])
        completion_rate = ((completed + finished) / total * 100) if total > 0 else 0

        # Por quem pediu
        by_requester = defaultdict(int)
        for task in recent_tasks:
            who = task.get('who', '').strip()
            if who:
                by_requester[who] += 1

        # Por prioridade
        by_priority = defaultdict(int)
        for task in recent_tasks:
            by_priority[task['priority']] += 1

        # Por categoria
        by_category = defaultdict(int)
        for task in recent_tasks:
            by_category[task.get('category', 'other')] += 1

        # Por empresa
        by_company = defaultdict(int)
        for task in recent_tasks:
            company = task.get('company', '').strip()
            if company:
                by_company[company] += 1

        # Tarefas por dia (últimas 2 semanas)
        tasks_by_day = defaultdict(int)
        completed_by_day = defaultdict(int)

        for task in recent_tasks:
            created_date = datetime.fromisoformat(task['created']).date()
            tasks_by_day[created_date] += 1

            if task['status'] in ['done', 'finished']:
                completed_date = datetime.fromisoformat(task['updated']).date()
                completed_by_day[completed_date] += 1

        # Tempo médio de conclusão
        completion_times = []
        for task in recent_tasks:
            if task['status'] in ['done', 'finished']:
                created = datetime.fromisoformat(task['created'])
                updated = datetime.fromisoformat(task['updated'])
                hours = (updated - created).total_seconds() / 3600
                completion_times.append(hours)

        avg_completion_time = sum(completion_times) / len(completion_times) if completion_times else 0

        # === CONSTRUIR WIDGETS ===
        widgets = []

        # Visão Geral
        widgets.append(urwid.Divider())
        widgets.append(urwid.Text(('status_doing', "📊 Visão Geral"), align='center'))
        widgets.append(urwid.Divider())

        overview_lines = [
            f"Total de tarefas: {total}",
            f"Concluídas: {completed} (aguardando confirmação)",
            f"Finalizadas: {finished} (confirmadas)",
            f"Taxa de conclusão: {completion_rate:.1f}%",
            f"Em progresso: {in_progress}",
            f"Pausadas: {paused}",
            f"Bloqueadas: {blocked}",
            f"Tempo médio de conclusão: {avg_completion_time:.1f}h"
        ]
        for line in overview_lines:
            widgets.append(urwid.Text(('body', f"  {line}")))

        # Timeline de Tarefas Criadas
        widgets.append(urwid.Divider())
        widgets.append(urwid.Text(('status_doing', "📅 Tarefas Criadas (últimos 14 dias)"), align='center'))
        widgets.append(urwid.Divider())
        timeline = draw_timeline_chart(tasks_by_day, days=14)
        widgets.append(urwid.Text(('body', timeline)))

        # Timeline de Tarefas Concluídas
        if completed_by_day:
            widgets.append(urwid.Divider())
            widgets.append(urwid.Text(('status_done', "✅ Tarefas Concluídas (últimos 14 dias)"), align='center'))
            widgets.append(urwid.Divider())
            completion_timeline = draw_timeline_chart(completed_by_day, days=14)
            widgets.append(urwid.Text(('body', completion_timeline)))

        # Por Solicitante
        if by_requester:
            widgets.append(urwid.Divider())
            widgets.append(urwid.Text(('status_doing', "👥 Tarefas por Solicitante"), align='center'))
            widgets.append(urwid.Divider())
            requester_data = dict(sorted(by_requester.items(), key=lambda x: x[1], reverse=True)[:10])
            requester_chart = draw_bar_chart(requester_data, max_width=40)
            widgets.append(urwid.Text(('body', requester_chart)))

        # Por Categoria
        if by_category:
            widgets.append(urwid.Divider())
            widgets.append(urwid.Text(('status_doing', "📂 Distribuição por Categoria"), align='center'))
            widgets.append(urwid.Divider())
            category_data = {}
            for cat, count in sorted(by_category.items(), key=lambda x: x[1], reverse=True):
                cat_info = CATEGORIES[cat]
                category_data[f"{cat_info['emoji']} {cat_info['label']}"] = count
            category_chart = draw_bar_chart(category_data, max_width=40)
            widgets.append(urwid.Text(('body', category_chart)))

        # Por Empresa
        if by_company:
            widgets.append(urwid.Divider())
            widgets.append(urwid.Text(('status_doing', "🏢 Tarefas por Empresa"), align='center'))
            widgets.append(urwid.Divider())
            company_data = dict(sorted(by_company.items(), key=lambda x: x[1], reverse=True)[:10])
            company_chart = draw_bar_chart(company_data, max_width=40)
            widgets.append(urwid.Text(('body', company_chart)))

        # Por Prioridade
        widgets.append(urwid.Divider())
        widgets.append(urwid.Text(('status_doing', "🎯 Distribuição por Prioridade"), align='center'))
        widgets.append(urwid.Divider())
        priority_data = {
            f"{PRIORITY['high']['emoji']} High": by_priority.get('high', 0),
            f"{PRIORITY['medium']['emoji']} Medium": by_priority.get('medium', 0),
            f"{PRIORITY['low']['emoji']} Low": by_priority.get('low', 0)
        }
        priority_chart = draw_bar_chart(priority_data, max_width=40)
        widgets.append(urwid.Text(('body', priority_chart)))

        # Insights
        insights = []

        if completion_rate < 50:
            insights.append("⚠️  Taxa de conclusão baixa. Considere revisar prioridades.")
        elif completion_rate > 80:
            insights.append("🎉 Excelente taxa de conclusão!")

        if blocked > 0:
            insights.append(f"🚫 Você tem {blocked} tarefa(s) bloqueada(s). Revise-as!")

        if paused > 0:
            insights.append(f"⏸️  {paused} tarefa(s) pausada(s). Considere retomá-las.")

        if avg_completion_time > 48:
            insights.append("⏰ Tarefas levam em média mais de 2 dias. Considere quebrar em tarefas menores.")

        if by_requester:
            top_requester = max(by_requester.items(), key=lambda x: x[1])
            insights.append(f"👤 Maior solicitante: {top_requester[0]} com {top_requester[1]} tarefas")

        if by_company:
            top_company = max(by_company.items(), key=lambda x: x[1])
            insights.append(f"🏢 Empresa com mais tarefas: {top_company[0]} ({top_company[1]} tarefas)")

        if by_category:
            top_category = max(by_category.items(), key=lambda x: x[1])
            cat_info = CATEGORIES[top_category[0]]
            insights.append(f"{cat_info['emoji']} Categoria dominante: {cat_info['label']} ({top_category[1]} tarefas)")

        if insights:
            widgets.append(urwid.Divider())
            widgets.append(urwid.Text(('status_doing', "💡 Insights"), align='center'))
            widgets.append(urwid.Divider())
            for insight in insights:
                widgets.append(urwid.Text(('body', f"  {insight}")))

        widgets.append(urwid.Divider())
        widgets.append(urwid.Divider())

        return widgets

    def keypress(self, size, key):
        """Handler de teclas - scroll e mudança de período"""
        # Vim-style navigation
        if key == 'j':
            key = 'down'
        elif key == 'k':
            key = 'up'

        if key == 'esc':
            self.app.pop_screen()
            return None
        elif key == '7':
            # Recarregar com 7 dias
            new_screen = MetricsScreen(self.app, days=7)
            self.app.screen_stack.pop()
            self.app.screen_stack.append(new_screen)
            self.app.main_widget.original_widget = new_screen
            return None
        elif key == '3':
            # Recarregar com 30 dias
            new_screen = MetricsScreen(self.app, days=30)
            self.app.screen_stack.pop()
            self.app.screen_stack.append(new_screen)
            self.app.main_widget.original_widget = new_screen
            return None
        elif key == '9':
            # Recarregar com 90 dias
            new_screen = MetricsScreen(self.app, days=90)
            self.app.screen_stack.pop()
            self.app.screen_stack.append(new_screen)
            self.app.main_widget.original_widget = new_screen
            return None

        return super().keypress(size, key)


# ============================================================================
# Agenda Screens
# ============================================================================

class EventDetailScreen(urwid.WidgetWrap):
    """Tela de detalhes de um evento - layout rico similar a TaskDetailScreen"""

    def __init__(self, app, event):
        self.app = app
        self.event = event

        # Extrair dados
        summary = event.get('summary', 'Sem título')
        description = event.get('description', '')
        location = event.get('location', '')
        link = event.get('htmlLink', '')
        creator = event.get('creator', {}).get('email', '')
        organizer = event.get('organizer', {}).get('email', '')
        attendees = event.get('attendees', [])
        status = event.get('status', 'confirmed')
        visibility = event.get('visibility', 'default')
        recurring = 'recurringEventId' in event
        hangout_link = event.get('hangoutLink', '')
        conference = event.get('conferenceData', {})
        created = event.get('created', '')
        updated = event.get('updated', '')

        start = event['start'].get('dateTime', event['start'].get('date'))
        end = event['end'].get('dateTime', event['end'].get('date'))

        # Formatar datas
        is_all_day = 'date' in event['start'] and 'dateTime' not in event['start']
        try:
            dt_start = datetime.fromisoformat(start.replace('Z', '+00:00'))
            dt_end = datetime.fromisoformat(end.replace('Z', '+00:00'))

            if is_all_day:
                date_str = dt_start.strftime('%A, %d de %B de %Y')
                time_str = "Dia inteiro"
            else:
                date_str = dt_start.strftime('%A, %d de %B de %Y')
                time_str = f"{dt_start.strftime('%H:%M')} - {dt_end.strftime('%H:%M')}"

                # Calcular duração
                duration = dt_end - dt_start
                hours, remainder = divmod(duration.seconds, 3600)
                minutes = remainder // 60
                if hours > 0:
                    duration_str = f"{hours}h{minutes:02d}min"
                else:
                    duration_str = f"{minutes}min"
        except:
            date_str = start
            time_str = f"{start} - {end}"
            duration_str = ""

        # Verificar se é hoje/amanhã
        today = datetime.now().date()
        tomorrow = today + timedelta(days=1)
        try:
            event_date = dt_start.date()
            if event_date == today:
                day_badge = ('warning', " HOJE ")
            elif event_date == tomorrow:
                day_badge = ('success', " AMANHÃ ")
            elif event_date < today:
                day_badge = ('error', " PASSADO ")
            else:
                days_until = (event_date - today).days
                day_badge = ('dimmed', f" em {days_until} dias ")
        except:
            day_badge = None

        # Header
        header_text = urwid.Text(f"━━━ 📅 DETALHES DO EVENTO ━━━", align='center')
        header = urwid.AttrMap(header_text, 'header')

        # ══════════════════════════════════════════════════════════════
        # PAINEL ESQUERDO: Informações principais
        # ══════════════════════════════════════════════════════════════

        info_content = [
            urwid.Text(('title', f" {summary}")),
            urwid.Divider(),
        ]

        if day_badge:
            info_content.append(urwid.Text(day_badge))
            info_content.append(urwid.Divider())

        # Data e hora
        info_content.append(urwid.Text(('subtitle', " 🗓️  Data e Hora")))
        info_content.append(urwid.Divider('─'))
        info_content.append(urwid.Text(f"   {date_str}"))
        info_content.append(urwid.Text(f"   ⏰ {time_str}"))
        if duration_str:
            info_content.append(urwid.Text(('dimmed', f"   ⏱️  Duração: {duration_str}")))
        if recurring:
            info_content.append(urwid.Text(('dimmed', "   🔄 Evento recorrente")))

        # Indicador de notificações
        if event_has_notifications(event):
            info_content.append(urwid.Text(('success', "   🔔 Notificações ativas")))

        info_content.append(urwid.Divider())

        # Local
        if location:
            info_content.append(urwid.Text(('subtitle', " 📍 Local")))
            info_content.append(urwid.Divider('─'))
            info_content.append(urwid.Text(f"   {location}"))
            info_content.append(urwid.Divider())

        # Link de videoconferência
        if hangout_link:
            info_content.append(urwid.Text(('subtitle', " 🎥 Videoconferência")))
            info_content.append(urwid.Divider('─'))
            info_content.append(urwid.Text(('success', f"   Google Meet")))
            info_content.append(urwid.Text(('dimmed', f"   {hangout_link}")))
            info_content.append(urwid.Divider())
        elif conference:
            conf_type = conference.get('conferenceSolution', {}).get('name', 'Reunião')
            info_content.append(urwid.Text(('subtitle', " 🎥 Videoconferência")))
            info_content.append(urwid.Divider('─'))
            info_content.append(urwid.Text(('success', f"   {conf_type}")))
            info_content.append(urwid.Divider())

        info_pile = urwid.Pile(info_content)
        info_filler = urwid.Filler(info_pile, valign='top')
        info_box = urwid.LineBox(info_filler, title="Informações")

        # ══════════════════════════════════════════════════════════════
        # PAINEL DIREITO: Detalhes adicionais
        # ══════════════════════════════════════════════════════════════

        details_content = []

        # Organizador/Criador
        if organizer or creator:
            details_content.append(urwid.Text(('subtitle', " 👤 Organizador")))
            details_content.append(urwid.Divider('─'))
            details_content.append(urwid.Text(f"   {organizer or creator}"))
            details_content.append(urwid.Divider())

        # Status
        details_content.append(urwid.Text(('subtitle', " ℹ️  Status")))
        details_content.append(urwid.Divider('─'))
        status_map = {
            'confirmed': ('success', '✅ Confirmado'),
            'tentative': ('warning', '❓ Tentativo'),
            'cancelled': ('error', '❌ Cancelado'),
        }
        st_style, st_text = status_map.get(status, ('text', status))
        details_content.append(urwid.Text((st_style, f"   {st_text}")))
        details_content.append(urwid.Divider())

        # Criado/Atualizado
        if created or updated:
            details_content.append(urwid.Text(('subtitle', " 📆 Histórico")))
            details_content.append(urwid.Divider('─'))
            if created:
                try:
                    dt_created = datetime.fromisoformat(created.replace('Z', '+00:00'))
                    created_str = dt_created.strftime('%d/%m/%Y %H:%M')
                except:
                    created_str = created
                details_content.append(urwid.Text(('dimmed', f"   Criado: {created_str}")))
            if updated:
                try:
                    dt_updated = datetime.fromisoformat(updated.replace('Z', '+00:00'))
                    updated_str = dt_updated.strftime('%d/%m/%Y %H:%M')
                except:
                    updated_str = updated
                details_content.append(urwid.Text(('dimmed', f"   Atualizado: {updated_str}")))
            details_content.append(urwid.Divider())

        # Participantes (no final, usa espaço restante)
        if attendees:
            details_content.append(urwid.Text(('subtitle', f" 👥 Participantes ({len(attendees)})")))
            details_content.append(urwid.Divider('─'))

            # Organizar em 2 colunas para usar melhor o espaço
            att_list = []
            for att in attendees:
                email = att.get('email', '')
                name = att.get('displayName', email.split('@')[0])
                response = att.get('responseStatus', 'needsAction')

                if response == 'accepted':
                    icon = "✅"
                elif response == 'declined':
                    icon = "❌"
                elif response == 'tentative':
                    icon = "❓"
                else:
                    icon = "⏳"

                is_org = att.get('organizer', False)
                org_mark = " ◆" if is_org else ""
                name_truncated = name[:16] if is_org else name[:18]
                att_list.append(f"{icon} {name_truncated}{org_mark}")

            # Criar 2 colunas
            for i in range(0, len(att_list), 2):
                col1 = att_list[i] if i < len(att_list) else ""
                col2 = att_list[i+1] if i+1 < len(att_list) else ""
                details_content.append(urwid.Text(f" {col1:<22} {col2}"))

            details_content.append(urwid.Divider())

        if not details_content:
            details_content.append(urwid.Text(('dimmed', " Sem detalhes adicionais")))

        details_pile = urwid.Pile(details_content)
        details_filler = urwid.Filler(details_pile, valign='top')
        details_box = urwid.LineBox(details_filler, title="Detalhes")

        # ══════════════════════════════════════════════════════════════
        # DESCRIÇÃO (Parte inferior, se existir)
        # ══════════════════════════════════════════════════════════════

        if description:
            desc_content = [
                urwid.Text(description),
            ]
            desc_pile = urwid.Pile(desc_content)
            desc_filler = urwid.Filler(desc_pile, valign='top')
            desc_box = urwid.LineBox(desc_filler, title="📝 Descrição")
        else:
            desc_box = None

        # ══════════════════════════════════════════════════════════════
        # LAYOUT FINAL
        # ══════════════════════════════════════════════════════════════

        # Colunas: Info (60%) | Detalhes (40%)
        top_columns = urwid.Columns([
            ('weight', 60, info_box),
            ('weight', 40, details_box),
        ], dividechars=0)

        if desc_box:
            body = urwid.Pile([
                ('weight', 70, top_columns),
                ('weight', 30, desc_box),
            ])
        else:
            body = top_columns

        # Footer com opção de notificação
        self.has_notif = event_has_notifications(event)
        self.update_footer()

        self.frame = urwid.Frame(header=header, body=body, footer=self.footer)
        super().__init__(self.frame)

    def update_footer(self):
        """Atualiza footer com status de notificação"""
        if self.has_notif:
            notif_text = "[N]🔔 Remover notif."
        else:
            notif_text = "[n]🔕 Criar notif."

        footer_text = urwid.Text(
            f"━ [ESC/q]Voltar [j/k]Scroll {notif_text} ━",
            align='center'
        )
        self.footer = urwid.AttrMap(footer_text, 'footer')

        if hasattr(self, 'frame'):
            self.frame.footer = self.footer

    def show_message(self, msg, style='text'):
        """Mostra mensagem temporária no footer"""
        footer_text = urwid.Text(('warning', f"  {msg}  "), align='center')
        self.frame.footer = urwid.AttrMap(footer_text, 'footer')
        # Restaurar footer original após 2 segundos
        def restore(loop, data):
            self.update_footer()
        self.app.loop.set_alarm_in(2, restore)

    def keypress(self, size, key):
        if key in ('esc', 'q'):
            self.app.pop_screen()
            return None

        if key == 'j':
            key = 'down'
        elif key == 'k':
            key = 'up'

        # n - Criar notificações
        if key == 'n' and not self.has_notif:
            success, msg = create_event_notifications(self.event)
            if success:
                self.has_notif = True
                self.show_message(f"✅ {msg}")
            else:
                self.show_message(f"❌ {msg}")
            self.update_footer()
            return None

        # N (shift+n) - Remover notificações
        if key == 'N' and self.has_notif:
            success, msg = remove_event_notifications(self.event)
            if success:
                self.has_notif = False
                self.show_message(f"✅ {msg}")
            else:
                self.show_message(f"❌ {msg}")
            self.update_footer()
            return None

        return super().keypress(size, key)


class AgendaEventRow(urwid.WidgetWrap):
    """Linha da lista de agenda - formato igual ao TaskRow (texto simples)"""

    def __init__(self, event):
        self.event = event

        start = event['start'].get('dateTime', event['start'].get('date'))
        end = event['end'].get('dateTime', event['end'].get('date'))
        is_all_day = 'date' in event['start'] and 'dateTime' not in event['start']

        time_str = "Dia todo"
        duration_str = "     "

        try:
            dt_start = datetime.fromisoformat(start.replace('Z', '+00:00'))
            dt_end = datetime.fromisoformat(end.replace('Z', '+00:00'))

            if not is_all_day:
                time_str = dt_start.strftime("%H:%M")

                # Duração
                duration = dt_end - dt_start
                hours, remainder = divmod(duration.seconds, 3600)
                minutes = remainder // 60
                if hours > 0:
                    duration_str = f"{hours}h{minutes:02d}m"
                else:
                    duration_str = f" {minutes:2d}m "
        except:
            pass

        summary = event.get('summary', 'Sem título')
        location = event.get('location', '')
        hangout = event.get('hangoutLink', '')
        attendees = event.get('attendees', [])
        status = event.get('status', 'confirmed')

        # Truncar título
        max_len = 40
        if len(summary) > max_len:
            summary = summary[:max_len-3] + '...'

        # Truncar local
        if location:
            loc_short = location[:20] + "..." if len(location) > 20 else location
        else:
            loc_short = "-"

        # Ícones fixos
        icon_meet = "🎥" if (hangout or event.get('conferenceData')) else "  "
        icon_loc = "📍" if location else "  "
        icon_recur = "🔄" if 'recurringEventId' in event else "  "
        attendees_str = f"👥{len(attendees):2d}" if attendees else "    "

        # Status
        if status == 'cancelled':
            status_icon = "❌"
        elif status == 'tentative':
            status_icon = "❓"
        else:
            status_icon = "📅"

        # Linha única formatada (igual TaskRow)
        line_text = f" {status_icon} {time_str:<8} {duration_str:<5} │ {summary:<40} │ {icon_loc}{loc_short:<23} │ {icon_meet} {attendees_str} {icon_recur}"

        # Widget de texto simples
        text_widget = urwid.Text(line_text)

        # AttrMap para focus funcionar (igual TaskRow)
        attr_map = urwid.AttrMap(text_widget, 'task_row', focus_map='task_row_focus')

        super().__init__(attr_map)

    def selectable(self):
        return True

    def keypress(self, size, key):
        return key


class AgendaListScreen(urwid.WidgetWrap):
    """Tela de lista completa da Agenda - estilo similar ao MainScreen"""

    def __init__(self, app):
        self.app = app
        self.events = []
        self.show_recurring = True  # Eventos recorrentes ativados por padrão

        # Walker para lista de eventos
        self.event_walker = urwid.SimpleFocusListWalker([])
        self.event_list = urwid.ListBox(self.event_walker)
        self.event_box = urwid.LineBox(self.event_list, title="Eventos")

        # Painel de stats (esquerda)
        self.stats_box = self.build_stats_panel()

        # Layout em colunas: Stats (25%) | Eventos (75%)
        self.columns = urwid.Columns([
            ('weight', 25, self.stats_box),
            ('weight', 75, self.event_box),
        ], dividechars=0)

        # Carregar eventos
        self.load_events()

        # Header
        self.update_header()

        # Footer
        self.update_footer()

    def update_footer(self):
        """Atualiza footer com status do filtro de recorrentes"""
        recur_status = "ON" if self.show_recurring else "OFF"
        footer_text = urwid.Text(
            f"━ [r]Atualizar [R]Recorrentes:{recur_status} [Enter]Detalhes [j/k]Navegar [ESC]Voltar ━",
            align='center'
        )
        self.footer = urwid.AttrMap(footer_text, 'footer')

        if hasattr(self, '_w') and isinstance(self._w, urwid.Frame):
            self._w.footer = self.footer

        # Frame
        frame = urwid.Frame(
            header=self.header,
            body=self.columns,
            footer=self.footer
        )

        super().__init__(frame)

    def build_stats_panel(self):
        """Constrói painel de estatísticas"""
        today = datetime.now().date()

        # Contar eventos por período
        today_count = 0
        tomorrow_count = 0
        week_count = 0

        for event in self.events:
            start = event['start'].get('dateTime', event['start'].get('date'))
            try:
                dt = datetime.fromisoformat(start.replace('Z', '+00:00')).date()
                if dt == today:
                    today_count += 1
                elif dt == today + timedelta(days=1):
                    tomorrow_count += 1
                if dt <= today + timedelta(days=7):
                    week_count += 1
            except:
                pass

        # Status do filtro de recorrentes
        recur_style = 'success' if self.show_recurring else 'dimmed'
        recur_text = "🔄 Mostrar" if self.show_recurring else "🔄 Ocultar"

        content = [
            urwid.Text(('subtitle', " 📊 Resumo")),
            urwid.Divider('─'),
            urwid.Text(f" Hoje: {today_count}"),
            urwid.Text(f" Amanhã: {tomorrow_count}"),
            urwid.Text(f" 7 dias: {week_count}"),
            urwid.Text(f" Total: {len(self.events)}"),
            urwid.Divider('─'),
            urwid.Text(('dimmed', f" {today.strftime('%d/%m/%Y')}")),
            urwid.Divider(),
            urwid.Text(('subtitle', " ⚙️ Filtros")),
            urwid.Divider('─'),
            urwid.Text((recur_style, f" {recur_text}")),
            urwid.Text(('dimmed', "   recorrentes")),
            urwid.Divider(),
            urwid.Text(('subtitle', " 📅 Legenda")),
            urwid.Divider('─'),
            urwid.Text(('warning', " ● Hoje")),
            urwid.Text(('success', " ● Amanhã")),
            urwid.Text(('text', " ● Próximos")),
        ]

        pile = urwid.Pile(content)
        filler = urwid.Filler(pile, valign='top')
        return urwid.LineBox(filler, title="Stats")

    def update_header(self):
        """Atualiza header com contagem de eventos"""
        total = len(self.events)
        today = datetime.now().strftime('%d/%m/%Y')

        header_text = urwid.Text(
            f"━━━ 📅 GOOGLE AGENDA ━━━ {total} eventos ━━━ {today} ━━━",
            align='center'
        )
        self.header = urwid.AttrMap(header_text, 'header')

        if hasattr(self, '_w') and isinstance(self._w, urwid.Frame):
            self._w.header = self.header

    def load_events(self):
        """Carrega eventos do Google Calendar"""
        self.event_walker.clear()

        # Buscar eventos
        all_events = self.app.state.calendar_api.get_upcoming_events(max_results=50) or []

        # Filtrar eventos recorrentes se show_recurring = False
        if self.show_recurring:
            self.events = all_events
        else:
            self.events = [e for e in all_events if 'recurringEventId' not in e]

        if not self.events:
            empty = urwid.Text(('dimmed', "\n  📭 Nenhum evento encontrado\n\n  Verifique sua conexão com o Google Calendar."), align='left')
            self.event_walker.append(empty)
            return

        # Agrupar por dia
        current_day = None
        today = datetime.now().date()
        tomorrow = today + timedelta(days=1)

        for event in self.events:
            start = event['start'].get('dateTime', event['start'].get('date'))
            try:
                dt = datetime.fromisoformat(start.replace('Z', '+00:00'))
                event_day = dt.date()
            except:
                event_day = None

            # Separador de dia
            if event_day and event_day != current_day:
                current_day = event_day

                if event_day == today:
                    day_label = "📍 HOJE"
                    day_style = 'warning'
                elif event_day == tomorrow:
                    day_label = "📆 AMANHÃ"
                    day_style = 'success'
                else:
                    day_label = f"📅 {event_day.strftime('%A, %d/%m').upper()}"
                    day_style = 'subtitle'

                # Adicionar separador
                self.event_walker.append(urwid.Divider())
                separator = urwid.AttrMap(
                    urwid.Text(f" {day_label} ", align='left'),
                    day_style
                )
                self.event_walker.append(separator)
                self.event_walker.append(urwid.Divider('─'))

            # Adicionar evento
            self.event_walker.append(AgendaEventRow(event))

        # Atualizar stats
        self.stats_box = self.build_stats_panel()
        self.columns.contents[0] = (self.stats_box, ('weight', 25, False))

        # Atualizar header
        self.update_header()

    def refresh(self):
        """Recarrega os eventos"""
        self.app.state.load_events()
        self.load_events()

    def keypress(self, size, key):
        # ESC - Voltar
        if key in ('esc', 'q'):
            self.app.pop_screen()
            return None

        # Enter - Detalhes do evento
        if key in ('enter', ' '):
            focus_widget = self.event_list.focus
            if focus_widget and isinstance(focus_widget, AgendaEventRow):
                detail = EventDetailScreen(self.app, focus_widget.event)
                self.app.push_screen(detail)
            return None

        # r - Refresh
        if key == 'r':
            self.refresh()
            return None

        # R - Toggle eventos recorrentes
        if key == 'R':
            self.show_recurring = not self.show_recurring
            self.load_events()
            self.update_footer()
            return None

        # Vim-style navigation
        if key == 'j':
            key = 'down'
        elif key == 'k':
            key = 'up'

        # g - Ir para início
        if key == 'g':
            if self.event_walker:
                self.event_list.focus_position = 0
            return None

        # G - Ir para fim
        if key == 'G':
            if self.event_walker:
                self.event_list.focus_position = len(self.event_walker) - 1
            return None

        return super().keypress(size, key)

# ============================================================================
# StatsPanel - Painel esquerdo com estatísticas e eventos
# ============================================================================

class AgendaPanel(urwid.WidgetWrap):
    """Painel esquerdo: Apenas Agenda (Eventos)"""

    def __init__(self, app):
        self.app = app
        self.build_content()

    def build_content(self):
        """Constrói o conteúdo do painel"""
        content_widgets = []

        # Filtrar eventos recorrentes (mostrar apenas não-recorrentes)
        non_recurring = [e for e in self.app.state.events if 'recurringEventId' not in e]

        if non_recurring:
            today = datetime.now().date()
            for event in non_recurring[:4]: # Max 4 eventos para caber na horizontal
                start = event['start'].get('dateTime', event['start'].get('date'))
                try:
                    dt = datetime.fromisoformat(start.replace('Z', '+00:00'))
                    if dt.date() == today:
                         time_str = f"Hoje {dt.strftime('%H:%M')}"
                         style = 'warning'
                    else:
                         time_str = dt.strftime("%d/%m %H:%M")
                         style = 'secondary'
                except:
                    time_str = start
                    style = 'secondary'
                
                summary = event.get('summary', 'Sem título')

                # Criar widget de texto que adapta ao espaço disponível
                # wrap='space' quebra em palavras, adaptando ao espaço
                event_text = urwid.Text([
                    (style, f"{time_str}\n"),
                    ('text', summary)
                ], align='center', wrap='space')

                # Wrap em um LineBox para dar "corpo" ao evento
                event_box = urwid.LineBox(event_text)
                content_widgets.append(('weight', 1, event_box))
            
            # Se não houver eventos suficientes para preencher, urwid expande os existentes.
            # Columns divide o espaço.
            self.inner_widget = urwid.Columns(content_widgets, dividechars=1)
        else:
             self.inner_widget = urwid.Text(('dimmed', "Sem eventos próximos"), align='center')

        # Wrap em LineBox principal da Agenda
        # Filler garante que o conteúdo não estique verticalmente mais que o necessário, 
        # mas aqui queremos que o painel ocupe o espaço do Pile. 
        # No Pile do MainScreen, este painel tem weight 1.
        
        # IMPORTANTE: Remover 'dialog_bg' para transparência (usar None)
        box = urwid.LineBox(self.inner_widget, title="📅 Agenda")
        self._w = urwid.AttrMap(box, None)


# ============================================================================
# ClickUpTodayPanel - Tasks de hoje do ClickUp
# ============================================================================

class ClickUpTodayPanel(urwid.WidgetWrap):
    """Painel lateral com tasks do ClickUp agrupadas por data e lista"""

    MAX_WIDTH = 35  # Largura máxima
    MIN_WIDTH = 20  # Largura mínima

    def __init__(self, app):
        self.app = app
        self.width = self.MIN_WIDTH
        self.build_content()

    def build_content(self):
        """Constrói o conteúdo do painel usando dados da API do ClickUp"""
        content = []
        line_widths = []  # Para calcular largura necessária
        today = datetime.now().date()
        tomorrow = today + timedelta(days=1)

        # Usar tasks do ClickUp carregadas na inicialização
        clickup_tasks = getattr(self.app, 'clickup_tasks', []) or []

        # Agrupar tasks por data (apenas hoje e futuro)
        tasks_by_date = {}

        for ct in clickup_tasks:
            # Status do ClickUp
            status_obj = ct.get('status', {})
            status_name = status_obj.get('status', '').lower() if isinstance(status_obj, dict) else ''
            if status_name in ('complete', 'done', 'closed', 'finished'):
                continue

            # Due date (timestamp em ms)
            due = ct.get('due_date')
            if due:
                try:
                    task_date = datetime.fromtimestamp(int(due) / 1000).date()
                    if task_date >= today:
                        if task_date not in tasks_by_date:
                            tasks_by_date[task_date] = []
                        tasks_by_date[task_date].append(ct)
                except:
                    pass

        # Ordenar datas
        sorted_dates = sorted(tasks_by_date.keys())

        # Função para ordenar tasks: por lista
        def sort_task(t):
            list_name = t.get('list', {}).get('name', '') or ''
            return list_name

        total_tasks = sum(len(tasks) for tasks in tasks_by_date.values())

        if total_tasks > 0:
            header = f" 📋 {total_tasks} tasks pendentes"
            content.append(urwid.Text(('warning', header)))
            line_widths.append(len(header) + 2)
            content.append(urwid.Divider('─'))

            for date in sorted_dates:
                tasks = tasks_by_date[date]
                tasks.sort(key=sort_task)

                # Header da data
                if date == today:
                    date_label = "📍 HOJE"
                    attr = 'warning'
                elif date == tomorrow:
                    date_label = "📆 AMANHÃ"
                    attr = 'info'
                else:
                    days_diff = (date - today).days
                    if days_diff <= 7:
                        weekdays = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom']
                        date_label = f"📅 {weekdays[date.weekday()]} ({date.strftime('%d/%m')})"
                    else:
                        date_label = f"📅 {date.strftime('%d/%m')}"
                    attr = 'dimmed'

                date_line = f" {date_label} ({len(tasks)})"
                content.append(urwid.Text((attr, date_line)))
                line_widths.append(len(date_line) + 2)

                # Agrupar por lista dentro da data
                tasks_by_list = {}
                for ct in tasks:
                    list_name = ct.get('list', {}).get('name', 'Sem Lista') or 'Sem Lista'
                    if list_name not in tasks_by_list:
                        tasks_by_list[list_name] = []
                    tasks_by_list[list_name].append(ct)

                for list_name, list_tasks in tasks_by_list.items():
                    # Sub-header da lista com contagem (só se > 1)
                    count_str = f" ({len(list_tasks)})" if len(list_tasks) > 1 else ""
                    list_line = f"   └ {list_name}{count_str}"
                    line_widths.append(len(list_line) + 2)
                    # Truncar se necessário para o display
                    short_list = list_name[:18] + "..." if len(list_name) > 18 else list_name
                    display_line = f"   └ {short_list}{count_str}"
                    content.append(urwid.Text(('dimmed', display_line)))

                content.append(urwid.Text(""))

            # Calcular largura necessária (+2 para margem direita)
            max_line = max(line_widths) if line_widths else self.MIN_WIDTH
            self.width = min(max(max_line + 2, self.MIN_WIDTH), self.MAX_WIDTH)

        else:
            content.append(urwid.Text(('success', "\n ✅ Nenhuma task\n    pendente!"), align='center'))
            self.width = self.MIN_WIDTH

        # Usar ListBox para scroll
        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(content))
        box = urwid.LineBox(listbox, title="📋 Empresas")
        self._w = urwid.AttrMap(box, None)


class MainScreen(urwid.WidgetWrap):
    """Tela principal: lista de tasks com filtros"""

    def __init__(self, app):
        self.app = app

        # --- Painéis ---
        self.agenda_panel = AgendaPanel(app)
        self.tasks_panel = ClickUpTodayPanel(app)

        # Painel de Tasks (Lista principal)
        self.task_list_walker = urwid.SimpleFocusListWalker([])
        self.task_list = urwid.ListBox(self.task_list_walker)
        self.task_box = urwid.LineBox(self.task_list, title="Tarefas")

        # Layout esquerdo: Tasks + Agenda empilhados
        self.left_pile = urwid.Pile([
            ('weight', 3, self.task_box),     # Lista de tasks - 75%
            ('weight', 1, self.agenda_panel), # Agenda - 25%
        ])

        # Layout principal: Esquerda (75%) | Painel Tasks (25%)
        self.body = urwid.Columns([
            ('weight', 1, self.left_pile),
            (self.tasks_panel.width, self.tasks_panel),
        ], dividechars=0)

        # Para navegação
        self.pile = self.left_pile

        # Populartasks inicialmente
        self.refresh_task_list()
        
        # Header inicial
        self.update_header()

        # Footer com hints
        footer_text = urwid.Text(
            "━ [q]Quit [t]Tasks [n]New [e]Edit [s]Status [m]Metrics [i]ClickUp [Tab]Agenda ━",
            align='center'
        )
        self.footer = urwid.AttrMap(footer_text, 'footer')

        # Frame: header + body + footer
        frame = urwid.Frame(
            header=self.header,
            body=self.body,
            footer=self.footer
        )
        # Foco inicial na lista de tasks (índice 0 no Pile)
        self.pile.focus_position = 0

        super().__init__(frame)

    def update_header(self):
        """Atualiza o header com contadores e filtros (RESTAURADO)"""
        total = len(self.app.state.tasks)
        filtered = len(self.app.state.get_filtered_tasks())

        # Mostrar filtros ativos
        active_filters = []
        if self.app.state.current_filter.get('status'):
            status = self.app.state.current_filter['status']
            active_filters.append(f"Status:{STATUS[status]['label']}")
        if self.app.state.current_filter.get('category'):
            cat = self.app.state.current_filter['category']
            active_filters.append(f"Cat:{CATEGORIES[cat]['label']}")
        if self.app.state.current_filter.get('company'):
            active_filters.append(f"Co:{self.app.state.current_filter['company']}")

        filter_str = " • ".join(active_filters) if active_filters else "TODAS"

        # Streak
        streak = self.app.state.get_streak()
        streak_icon = "🔥" if streak >= 7 else "⚡" if streak >= 3 else ""
        streak_str = f" {streak_icon}{streak}d " if streak > 0 else ""

        header_text = urwid.Text(
            f"{streak_str}━━━ 📋 QUICK TASKS ━━━ {filtered}/{total} tasks ━━━ Filtros: {filter_str} ━━━{streak_str}",
            align='center'
        )
        self.header = urwid.AttrMap(header_text, 'header')
        # Se frame já existe, atualizar
        if hasattr(self, '_w') and isinstance(self._w, urwid.Frame):
            self._w.header = self.header

    def refresh_task_list(self):
        """Recarrega a lista de tasks"""
        # Atualizar agenda
        self.agenda_panel.build_content()
        # Atualizar header
        self.update_header()
        
        # Limpar lista atual
        self.task_list_walker.clear()

        # Pegar tasks filtradas
        tasks = self.app.state.get_filtered_tasks()

        if not tasks:
            # Nenhuma task encontrada
            empty_msg = urwid.Text("📭 Nenhuma task encontrada", align='center')
            self.task_list_walker.append(empty_msg)
            self.task_list_walker.append(urwid.Divider())
            return

        # Mapeamento de prioridade para ordenação (high=0, medium=1, low=2)
        priority_order = {'high': 0, 'medium': 1, 'low': 2}

        # Agrupar por status e ordenar por prioridade (high primeiro) e depois por ID
        grouped = {}
        for task in sorted(tasks, key=lambda x: (x['status'], priority_order.get(x.get('priority', 'low'), 2), -x['id'])):
            status = task['status']
            if status not in grouped:
                grouped[status] = []
            grouped[status].append(task)

        # Ordem de exibição dos status
        status_order = ['blocked', 'doing', 'paused', 'todo', 'done', 'finished']

        # Adicionar tasks agrupadas
        for status_key in status_order:
            if status_key not in grouped:
                continue

            status_tasks = grouped[status_key]
            status_info = STATUS[status_key]

            # Divider do grupo - visual clean com azul
            divider_text = urwid.Text(
                ('subtitle', f"\n─── {status_info['emoji']} {status_info['label'].upper()} ({len(status_tasks)}) ───"),
                align='left'
            )
            self.task_list_walker.append(divider_text)

            # Tasks do grupo (versão compacta na tela principal)
            for task in status_tasks:
                task_row = CompactTaskRow(task)
                self.task_list_walker.append(task_row)

        # Adicionar espaçamento no final
        self.task_list_walker.append(urwid.Divider())

    def keypress(self, size, key):
        """Handler de teclas da tela principal"""
        # Vim-style navigation
        if key == 'j':
            key = 'down'
        elif key == 'k':
            key = 'up'

    def keypress(self, size, key):
        """Handler de teclas da tela principal"""
        # Navegação entre paineis
        if key == 'tab':
             # Abrir tela de agenda completa
             agenda_screen = AgendaListScreen(self.app)
             self.app.push_screen(agenda_screen)
             return None
        
        # Manter compatibilidade com Shift Tab ou remover se nao necessario
        elif key == 'shift tab': 
             agenda_screen = AgendaListScreen(self.app)
             self.app.push_screen(agenda_screen)
             return None
            
        # Vim-style navigation na lista atual
        if key == 'j':
            key = 'down'
        elif key == 'k':
            key = 'up'

        # Deixa Body processar navegação interna
        key = super().keypress(size, key)
        if not key:
            return None

        # Ações globais
        status_keys = {
            '1': 'todo', '2': 'doing', '3': 'paused',
            '4': 'done', '5': 'blocked', '6': 'finished',
        }

        if key in status_keys:
            self.app.state.current_filter['status'] = status_keys[key]
            if status_keys[key] == 'finished':
                self.app.state.current_filter['show_finished'] = True
            self.refresh_task_list()
            return None
        elif key == '0':
            self.app.state.current_filter = {}
            self.refresh_task_list()
            return None

        is_task_list_focused = (self.pile.focus_position == 0)
        
        if key == 'enter':
            if is_task_list_focused:
                focus_widget = self.task_list.focus
                if focus_widget and isinstance(focus_widget, (TaskRow, CompactTaskRow)):
                    detail_screen = TaskDetailScreen(self.app, focus_widget.task)
                    self.app.push_screen(detail_screen)
                return None
            return key
            
        elif key == 'n':
            edit_screen = TaskEditScreen(self.app, task=None)
            self.app.push_screen(edit_screen)
            return None
            
        elif key == 'e' and is_task_list_focused:
            focus_widget = self.task_list.focus
            if focus_widget and isinstance(focus_widget, (TaskRow, CompactTaskRow)):
                edit_screen = TaskEditScreen(self.app, focus_widget.task)
                self.app.push_screen(edit_screen)
            return None
            
        elif key == 's' and is_task_list_focused:
            focus_widget = self.task_list.focus
            if focus_widget and isinstance(focus_widget, (TaskRow, CompactTaskRow)):
                task = focus_widget.task
                def on_close():
                    self.app.close_overlay()
                    self.refresh_task_list()
                dialog = StatusDialog(self.app, task, on_close)
                self.app.show_overlay(dialog)
            return None

        elif key == 'p' and is_task_list_focused:
            focus_widget = self.task_list.focus
            if focus_widget and isinstance(focus_widget, (TaskRow, CompactTaskRow)):
                task = focus_widget.task
                def on_close():
                    self.app.close_overlay()
                    self.refresh_task_list()
                dialog = PriorityDialog(self.app, task, on_close)
                self.app.show_overlay(dialog)
            return None
            
        elif key == 'd' and is_task_list_focused:
            focus_widget = self.task_list.focus
            if focus_widget and isinstance(focus_widget, (TaskRow, CompactTaskRow)):
                task = focus_widget.task
                def on_yes():
                    self.app.state.delete_task(task['id'])
                    self.app.state.save_tasks()
                    self.app.close_overlay()
                    self.refresh_task_list()
                def on_no():
                    self.app.close_overlay()
                dialog = ConfirmDialog(
                    "Confirmar Exclusão",
                    f"Deletar task #{task['id']}?\n\n{task['description'][:50]}...",
                    on_yes=on_yes,
                    on_no=on_no
                )
                self.app.show_overlay(dialog, width=('relative', 60), height=('relative', 30))
            return None
            
        elif key == 'f':
            done_count = len([t for t in self.app.state.tasks if t['status'] == 'done'])
            if done_count == 0:
                return None
            def on_yes():
                self.app.state.bulk_finish_done_tasks()
                self.app.state.save_tasks()
                self.app.close_overlay()
                self.refresh_task_list()
            def on_no():
                self.app.close_overlay()
            dialog = ConfirmDialog(
                "Finalizar Tasks",
                f"Arquivar {done_count} tasks Concluídas?",
                on_yes=on_yes,
                on_no=on_no
            )
            self.app.show_overlay(dialog, width=('relative', 50), height=('relative', 25))
            return None

        elif key == 'i':
            # Importar do ClickUp
            import_screen = ClickUpImportScreen(self.app)
            self.app.push_screen(import_screen)
            return None

        elif key == 'm':
            # Métricas
            metrics_screen = MetricsScreen(self.app)
            self.app.push_screen(metrics_screen)
            return None

        elif key == 'r':
            # Refresh
            self.refresh_task_list()
            return None

        elif key == 't':
            # Tela cheia de tasks
            full_tasks_screen = FullTasksScreen(self.app)
            self.app.push_screen(full_tasks_screen)
            return None

        return key



# ============================================================================
# HelpScreen - Tela de ajuda com atalhos
# ============================================================================

class HelpScreen(urwid.WidgetWrap):
    """Tela de ajuda mostrando todos os atalhos do teclado"""

    def __init__(self, app):
        self.app = app

        # Header
        header_text = urwid.Text(
            ('header', "━━━ ❓ AJUDA - ATALHOS DO TECLADO ━━━ [ESC]Voltar [↑↓jk]Scroll ━━━"),
            align='center'
        )
        header = urwid.AttrMap(header_text, 'header')

        # Conteúdo de ajuda
        help_content = self._build_help_content()
        body = urwid.ListBox(urwid.SimpleFocusListWalker(help_content))

        # Frame
        frame = urwid.Frame(header=header, body=body)
        super().__init__(frame)

    def _build_help_content(self):
        """Constrói o conteúdo da ajuda"""
        widgets = []

        widgets.append(urwid.Divider())
        widgets.append(urwid.Text(('subtitle', "🌐 ATALHOS GLOBAIS"), align='center'))
        widgets.append(urwid.Divider())
        global_shortcuts = [
            ("q", "Sair da aplicação"),
            ("ESC", "Voltar / Fechar dialog"),
            ("?", "Abrir esta tela de ajuda"),
            ("↑ / ↓", "Navegar em listas"),
            ("j / k", "Navegar em listas (vim-style)"),
            ("Tab", "Próximo campo (em forms)"),
            ("Shift+Tab", "Campo anterior (em forms)"),
        ]
        for key, desc in global_shortcuts:
            widgets.append(urwid.Text(('text', f"  [{key:12}]  {desc}")))

        widgets.append(urwid.Divider())
        widgets.append(urwid.Text(('subtitle', "📋 TELA PRINCIPAL (Lista de Tasks)"), align='center'))
        widgets.append(urwid.Divider())
        main_shortcuts = [
