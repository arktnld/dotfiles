# ============================================================================
# Cron Notification Helpers
# ============================================================================

def get_event_cron_id(event):
    """Gera ID único para identificar crons de um evento"""
    event_id = event.get('id', '')
    # Usar só os primeiros 12 chars do ID
    return f"QT_EVENT_{event_id[:12]}"

def get_current_crontab():
    """Retorna o crontab atual do usuário"""
    try:
        result = subprocess.run(['crontab', '-l'], capture_output=True, text=True)
        if result.returncode == 0:
            return result.stdout
        return ""
    except:
        return ""

def set_crontab(content):
    """Define o crontab do usuário"""
    try:
        process = subprocess.Popen(
            ['crontab', '-'],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True
        )
        process.communicate(input=content)
        return process.returncode == 0
    except:
        return False

def event_has_notifications(event):
    """Verifica se evento já tem notificações agendadas"""
    cron_id = get_event_cron_id(event)
    crontab = get_current_crontab()
    return cron_id in crontab

def cleanup_expired_notifications():
    """Remove notificações de eventos que já passaram"""
    import re
    crontab = get_current_crontab()
    if not crontab:
        return 0

    today = datetime.now().date()
    lines = crontab.split('\n')
    new_lines = []
    removed = 0

    for line in lines:
        # Procurar por linhas com QT_EVENT e data de expiração
        match = re.search(r'# QT_EVENT_\w+@(\d{4}-\d{2}-\d{2})', line)
        if match:
            try:
                expiry_date = datetime.strptime(match.group(1), '%Y-%m-%d').date()
                if expiry_date < today:
                    removed += 1
                    continue  # Não incluir linha expirada
            except:
                pass
        new_lines.append(line)

    if removed > 0:
        new_crontab = '\n'.join(l for l in new_lines if l.strip())
        if new_crontab:
            new_crontab += '\n'
        set_crontab(new_crontab)

    return removed

def create_event_notifications(event):
    """Cria notificações cron para um evento"""
    start = event['start'].get('dateTime', event['start'].get('date'))
    summary = event.get('summary', 'Evento')

    # Parse da data/hora
    try:
        dt_start = datetime.fromisoformat(start.replace('Z', '+00:00'))
        # Converter para hora local
        dt_start = dt_start.astimezone()
    except:
        return False, "Erro ao processar data do evento"

    # Se o evento já passou, não criar
    if dt_start < datetime.now().astimezone():
        return False, "Evento já passou"

    cron_id = get_event_cron_id(event)

    # Tempos de notificação: 1h antes, 15min antes, 5min antes
    notifications = [
        (timedelta(hours=1), "Em 1 hora", "normal"),
        (timedelta(minutes=15), "Em 15 min", "normal"),
        (timedelta(minutes=5), "Em 5 min!", "critical"),
    ]

    cron_lines = []
    for delta, msg, urgency in notifications:
        notify_time = dt_start - delta

        # Só criar se ainda não passou
        if notify_time > datetime.now().astimezone():
            minute = notify_time.minute
            hour = notify_time.hour
            day = notify_time.day
            month = notify_time.month

            # Escapar aspas no título (cron usa sh, não precisa escapar !)
            safe_summary = summary.replace('"', '\\"').replace("'", "\\'")

            urgency_flag = "--urgency=critical" if urgency == "critical" else ""

            # Precisa de DISPLAY e DBUS_SESSION_BUS_ADDRESS para notify-send funcionar via cron
            uid = os.getuid()
            # Incluir data de expiração no comentário para limpeza automática
            expiry = notify_time.strftime('%Y-%m-%d')
            cron_line = f'{minute} {hour} {day} {month} * DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus notify-send "📅 {msg}" "{safe_summary}" {urgency_flag} # {cron_id}@{expiry}'
            cron_lines.append(cron_line)

    if not cron_lines:
        return False, "Evento muito próximo para criar notificações"

    # Adicionar ao crontab
    current = get_current_crontab()

    # Remover notificações antigas deste evento
    lines = [l for l in current.split('\n') if cron_id not in l]

    # Adicionar novas
    lines.extend(cron_lines)

    # Remover linhas vazias duplicadas
    new_crontab = '\n'.join(l for l in lines if l.strip()) + '\n'

    if set_crontab(new_crontab):
        return True, f"{len(cron_lines)} notificações criadas"
    else:
        return False, "Erro ao atualizar crontab"

def remove_event_notifications(event):
    """Remove notificações cron de um evento"""
    cron_id = get_event_cron_id(event)
    current = get_current_crontab()

    if cron_id not in current:
        return False, "Evento não tem notificações"

    # Filtrar linhas que não contêm o ID do evento
    lines = [l for l in current.split('\n') if cron_id not in l]
    new_crontab = '\n'.join(l for l in lines if l.strip())
    if new_crontab:
        new_crontab += '\n'

    if set_crontab(new_crontab):
        return True, "Notificações removidas"
    else:
        return False, "Erro ao atualizar crontab"


# ============================================================================
# ClickUp API Integration
# ============================================================================

def load_clickup_tasks():
    """Carrega tasks do ClickUp da API"""
    config = ClickUpAPI.load_config()
    api_token = config.get("clickup_api_token", "")

    if not api_token:
        return []

    try:
        api = ClickUpAPI(api_token)
        return api.get_all_my_tasks(include_closed=False)
    except:
        return []


def sync_clickup_due_dates(state, clickup_tasks=None):
    """Sincroniza due_dates e listas do ClickUp com tasks locais"""
    if clickup_tasks is None:
        clickup_tasks = load_clickup_tasks()

    if not clickup_tasks:
        return 0

    # Pegar tasks locais que têm clickup_id mas não têm due_date ou clickup_list
    tasks_to_sync = [t for t in state.tasks if t.get('clickup_id') and (not t.get('due_date') or not t.get('clickup_list'))]

    if not tasks_to_sync:
        return 0

    try:
        # Criar mapa de clickup_id -> {due_date, list_name}
        clickup_data = {}
        for ct in clickup_tasks:
            cid = ct.get('id')
            if cid:
                data = {}
                due = ct.get('due_date')
                if due:
                    try:
                        data['due_date'] = datetime.fromtimestamp(int(due) / 1000).isoformat()
                    except:
                        pass
                list_name = ct.get('list', {}).get('name', '')
                if list_name:
                    data['clickup_list'] = list_name
                if data:
                    clickup_data[cid] = data

        # Atualizar tasks locais
        updated = 0
        for task in tasks_to_sync:
            clickup_id = task.get('clickup_id')
            if clickup_id in clickup_data:
                data = clickup_data[clickup_id]
                if not task.get('due_date') and 'due_date' in data:
                    task['due_date'] = data['due_date']
                    updated += 1
                if not task.get('clickup_list') and 'clickup_list' in data:
                    task['clickup_list'] = data['clickup_list']
                    updated += 1

        if updated > 0:
            state.save_tasks()

        return updated
    except:
        return 0


class ClickUpAPI:
    """Cliente para API do ClickUp"""

    BASE_URL = "https://api.clickup.com/api/v2"

    def __init__(self, api_token=None):
        self.api_token = api_token
        self._user_id = None
        self._teams = None

    @staticmethod
    def load_config():
        """Carrega configuração (API token)"""
        if CONFIG_FILE.exists():
            try:
                with open(CONFIG_FILE, 'r') as f:
                    return json.load(f)
            except:
                pass
        return {}

    @staticmethod
    def save_config(config):
        """Salva configuração"""
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_FILE, 'w') as f:
            json.dump(config, f, indent=2)

    def _request(self, endpoint, params=None):
        """Faz request para API do ClickUp"""
        import urllib.request
        import urllib.parse

        url = f"{self.BASE_URL}{endpoint}"
        if params:
            url += "?" + urllib.parse.urlencode(params, doseq=True)

        req = urllib.request.Request(url)
        req.add_header("Authorization", self.api_token)
        req.add_header("Content-Type", "application/json")

        try:
            with urllib.request.urlopen(req, timeout=10) as response:
                return json.loads(response.read().decode())
        except Exception as e:
            return {"error": str(e)}

    def get_user(self):
        """Obtém usuário autenticado"""
        result = self._request("/user")
        if "user" in result:
            self._user_id = result["user"]["id"]
        return result

    def get_teams(self):
        """Obtém workspaces/teams"""
        result = self._request("/team")
        if "teams" in result:
            self._teams = result["teams"]
        return result

    def get_my_tasks(self, team_id, include_closed=False):
        """Obtém tasks atribuídas ao usuário"""
        if not self._user_id:
            self.get_user()

        params = {
            "assignees[]": [self._user_id],
            "include_closed": str(include_closed).lower(),
            "subtasks": "true",
            "order_by": "updated",
            "reverse": "true"
        }

        result = self._request(f"/team/{team_id}/task", params)
        return result.get("tasks", [])

    def get_all_my_tasks(self, include_closed=False):
        """Obtém todas as tasks atribuídas ao usuário em todos os workspaces"""
        if not self._teams:
            self.get_teams()

        all_tasks = []
        for team in (self._teams or []):
            tasks = self.get_my_tasks(team["id"], include_closed)
            for task in tasks:
                task["_team_name"] = team["name"]
            all_tasks.extend(tasks)

        return all_tasks

    @staticmethod
    def map_priority(clickup_priority):
        """Mapeia prioridade do ClickUp para qt"""
        if not clickup_priority:
            return "low"
        priority_id = clickup_priority.get("id")
        # ClickUp: 1=urgent, 2=high, 3=normal, 4=low
        if priority_id in (1, 2):
            return "high"
        elif priority_id == 3:
            return "medium"
        return "low"

    @staticmethod
    def map_status(clickup_status):
        """Mapeia status do ClickUp para qt"""
        if not clickup_status:
            return "todo"
        status_type = clickup_status.get("type", "").lower()
        status_name = clickup_status.get("status", "").lower()

        if status_type == "closed" or "done" in status_name or "complete" in status_name:
            return "done"
        elif status_type == "open":
            if "progress" in status_name or "doing" in status_name or "working" in status_name:
                return "doing"
            elif "block" in status_name or "wait" in status_name:
                return "blocked"
            elif "pause" in status_name or "hold" in status_name:
                return "paused"
        return "todo"


    @staticmethod
    def extract_company(task):
        """Tenta extrair nome da empresa da task (lista ou pasta)"""
        # Tentar da lista
        if task.get("list", {}).get("name"):
            return task["list"]["name"]
        # Tentar da pasta
        if task.get("folder", {}).get("name"):
            return task["folder"]["name"]
        # Tentar do space
        if task.get("space", {}).get("name"):
            return task["space"]["name"]
        return ""


# ============================================================================
# Google Calendar Integration
# ============================================================================

class GoogleCalendarAPI:
    """Cliente para API do Google Calendar"""

    SCOPES = ['https://www.googleapis.com/auth/calendar.readonly']
    CREDENTIALS_FILE = Path.home() / ".local/share/quicktasks/credentials.json"
    TOKEN_FILE = Path.home() / ".local/share/quicktasks/token.json"

    def __init__(self):
        self.service = None
        self.creds = None

    def authenticate(self):
        """Autentica com Google Calendar API"""
        from google.auth.transport.requests import Request
        from google.oauth2.credentials import Credentials
        from google_auth_oauthlib.flow import InstalledAppFlow
        from googleapiclient.discovery import build

        try:
            # Carregar token existente
            if self.TOKEN_FILE.exists():
                self.creds = Credentials.from_authorized_user_file(str(self.TOKEN_FILE), self.SCOPES)

            # Se não tem credenciais válidas, logar
            if not self.creds or not self.creds.valid:
                if self.creds and self.creds.expired and self.creds.refresh_token:
                    self.creds.refresh(Request())
                else:
                    if not self.CREDENTIALS_FILE.exists():
                        return False # Falha silenciosa se não configurado
                    
                    flow = InstalledAppFlow.from_client_secrets_file(
                        str(self.CREDENTIALS_FILE), self.SCOPES)
                    self.creds = flow.run_local_server(port=0)
                
                # Salvar token para proxima vez
                self.TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
                with open(self.TOKEN_FILE, 'w') as token:
                    token.write(self.creds.to_json())

            self.service = build('calendar', 'v3', credentials=self.creds)
            return True
        except Exception as e:
            # print(f"Erro na autenticação do Google Calendar: {e}")
            return False

    def get_upcoming_events(self, max_results=20):
        """Obtém próximos eventos"""
        if not self.service:
            if not self.authenticate():
                return []

        try:
            # Usar UTC aware datetime e formatar manualmente para garantir RFC3339 sem microsegundos e com Z
            now = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
            events_result = self.service.events().list(
                calendarId='primary', timeMin=now,
                maxResults=max_results, singleEvents=True,
                orderBy='startTime').execute()
            events = events_result.get('items', [])
            return events
        except Exception as e:
            # print(f"Erro ao buscar eventos: {e}")
            return []



# ============================================================================
# Funções de Gráficos com Plotext (compatível com Urwid)
# ============================================================================

def draw_bar_chart(data, max_width=60, show_values=True):
    """Desenha um gráfico de barras usando plotext"""
    if not data:
        return "(Sem dados)"

    plt.clear_figure()
    plt.bar(list(data.keys()), list(data.values()))
    plt.plotsize(max_width, 12)
    output = plt.build()

    # IMPORTANTE: Remover códigos ANSI para compatibilidade com urwid
    return plt.uncolorize(output)


def draw_timeline_chart(tasks_by_day, days=14):
    """Desenha um gráfico de timeline usando plotext"""
    if not tasks_by_day:
        return "(Sem dados)"

    today = datetime.now().date()
    dates = [(today - timedelta(days=i)) for i in range(days-1, -1, -1)]

    # Preparar dados
    date_labels = [d.strftime("%d/%m") for d in dates]
    values = [tasks_by_day.get(d, 0) for d in dates]
    x_indices = list(range(len(dates)))

    plt.clear_figure()
    plt.plot(x_indices, values, marker="braille")

    # Configurar labels do eixo X (mostrar apenas alguns)
    step = max(1, len(dates) // 7)
    x_ticks = x_indices[::step]
    x_tick_labels = [date_labels[i] for i in x_ticks]
    plt.xticks(x_ticks, x_tick_labels)

    plt.plotsize(70, 12)
    output = plt.build()

    # IMPORTANTE: Remover códigos ANSI para compatibilidade com urwid
    return plt.uncolorize(output)


# ============================================================================
# AppState - Gerenciamento centralizado de tasks
# ============================================================================

class AppState:
    """Gerencia o estado da aplicação e operações com tasks"""

    def __init__(self):
        self.tasks = []
        self.current_filter = {}  # {status: 'todo', category: 'dev', ...}
        self.selected_task_id = None
        self.dirty = False  # Flag para mudanças não salvas
        
        # Google Calendar
        self.calendar_api = GoogleCalendarAPI()
        self.events = []

    def load_tasks(self):
        """Carrega as tarefas do arquivo JSON"""
        DATA_FILE.parent.mkdir(parents=True, exist_ok=True)
        if not DATA_FILE.exists():
            self.tasks = []
            return

        try:
            with open(DATA_FILE, 'r', encoding='utf-8') as f:
                self.tasks = json.load(f)
        except json.JSONDecodeError:
            # JSON corrompido, backup e resetar
            backup_file = DATA_FILE.with_suffix('.json.corrupted')
            DATA_FILE.rename(backup_file)
            self.tasks = []

            self.tasks = []

    def load_events(self):
        """Carrega eventos do Google Calendar"""
        self.events = self.calendar_api.get_upcoming_events()

    def save_tasks(self):
        """Salva as tarefas no arquivo JSON"""
        with open(DATA_FILE, 'w', encoding='utf-8') as f:
            json.dump(self.tasks, f, ensure_ascii=False, indent=2)
        self.dirty = False

    def get_next_id(self):
        """Retorna o próximo ID disponível"""
        if not self.tasks:
            return 1
        return max(task['id'] for task in self.tasks) + 1

    def get_task(self, task_id):
        """Busca uma task pelo ID"""
        return next((t for t in self.tasks if t['id'] == task_id), None)

    def get_filtered_tasks(self):
        """Retorna tasks filtradas de acordo com current_filter"""
        tasks = self.tasks

        # Filtro por status
        if self.current_filter.get('status'):
            tasks = [t for t in tasks if t['status'] == self.current_filter['status']]

        # Filtro por categoria
        if self.current_filter.get('category'):
            tasks = [t for t in tasks if t.get('category') == self.current_filter['category']]

        # Filtro por empresa
        if self.current_filter.get('company'):
            company = self.current_filter['company'].lower()
            tasks = [t for t in tasks if company in t.get('company', '').lower()]

        # Esconder finalizadas por padrão (a menos que filtro explícito)
        if not self.current_filter.get('show_finished'):
            tasks = [t for t in tasks if t['status'] != 'finished']

        return tasks

    def get_streak(self):
        """Calcula o streak de dias com tasks concluidas"""
        from collections import defaultdict

        # Coletar dias com tasks finalizadas
        completed_days = set()
        for task in self.tasks:
            if task['status'] in ('done', 'finished'):
                try:
                    completed_date = datetime.fromisoformat(task['updated']).date()
                    completed_days.add(completed_date)
                except (ValueError, KeyError):
                    pass

        if not completed_days:
            return 0

        # Calcular streak a partir de hoje
        today = datetime.now().date()
        streak = 0
        current_date = today

        while current_date in completed_days:
            streak += 1
            current_date -= timedelta(days=1)

        return streak

    def add_task(self, description, priority='low', who='', category='other', company='', status='todo'):
        """Adiciona uma nova task"""
        task = {
            'id': self.get_next_id(),
            'description': description,
            'status': status,
            'priority': priority,
            'who': who,
            'category': category,
            'company': company,
            'comments': [],
            'created': datetime.now().isoformat(),
            'updated': datetime.now().isoformat()
        }
        self.tasks.append(task)
        self.dirty = True
        return task

    def update_task(self, task_id, **updates):
        """Atualiza campos de uma task"""
        task = self.get_task(task_id)
        if not task:
            return False

        # Atualizar campos
        for key, value in updates.items():
            if key not in ['id', 'created']:  # Campos imutáveis
                task[key] = value

        # Auto-atualizar timestamp
        task['updated'] = datetime.now().isoformat()

        # Se mudou para finished, adicionar timestamp
        if updates.get('status') == 'finished' and 'finished_at' not in task:
            task['finished_at'] = datetime.now().isoformat()

        self.dirty = True
        return True

    def delete_task(self, task_id):
        """Remove uma task"""
        task = self.get_task(task_id)
        if not task:
            return False

        self.tasks.remove(task)
        self.dirty = True
        return True

    def add_comment(self, task_id, comment_text):
        """Adiciona um comentário a uma task"""
        task = self.get_task(task_id)
        if not task:
            return False

        if 'comments' not in task:
            task['comments'] = []

        task['comments'].append({
            'text': comment_text,
            'timestamp': datetime.now().isoformat()
        })
        task['updated'] = datetime.now().isoformat()
        self.dirty = True
        return True

    def bulk_finish_done_tasks(self):
        """Move todas as tasks 'done' para 'finished'"""
        count = 0
        for task in self.tasks:
            if task['status'] == 'done':
                task['status'] = 'finished'
                task['finished_at'] = datetime.now().isoformat()
                task['updated'] = datetime.now().isoformat()
                count += 1

        if count > 0:
            self.dirty = True

        return count

    def add_todo(self, task_id, text):
        """Adicionar TODO à task"""
        task = self.get_task(task_id)
        if not task:
            return False

        if 'todos' not in task:
            task['todos'] = []

        task['todos'].append({'text': text, 'done': False})
        task['updated'] = datetime.now().isoformat()
        self.dirty = True
        return True

    def toggle_todo(self, task_id, todo_index):
        """Alternar estado done/not done de um TODO"""
        task = self.get_task(task_id)
        if not task:
            return False

        if 'todos' in task and 0 <= todo_index < len(task['todos']):
            task['todos'][todo_index]['done'] = not task['todos'][todo_index]['done']
            task['updated'] = datetime.now().isoformat()
            self.dirty = True
            return True

        return False

    def update_todo(self, task_id, todo_index, new_text):
        """Editar texto de um TODO"""
        task = self.get_task(task_id)
        if not task:
            return False

        if 'todos' in task and 0 <= todo_index < len(task['todos']):
            task['todos'][todo_index]['text'] = new_text
            task['updated'] = datetime.now().isoformat()
            self.dirty = True
            return True

        return False

    def delete_todo(self, task_id, todo_index):
        """Deletar um TODO"""
        task = self.get_task(task_id)
        if not task:
            return False

        if 'todos' in task and 0 <= todo_index < len(task['todos']):
            task['todos'].pop(todo_index)
            task['updated'] = datetime.now().isoformat()
            self.dirty = True
            return True

        return False


# ============================================================================
# Palette de cores para urwid (24-bit color support)
# ============================================================================

def create_palette():
    """Cria a palette de cores baseada em STATUS e PRIORITY"""
    palette = []

    # Cores de status
    for status_key, info in STATUS.items():
        palette.append((
            f'status_{status_key}',
            '',           # foreground (padrão)
            '',           # background (padrão)
            '',           # mono
            info['color'],  # foreground (24-bit)
            ''            # background (24-bit)
        ))

    # Cores de prioridade
    for priority_key, info in PRIORITY.items():
        palette.append((
            f'priority_{priority_key}',
            '',
            '',
            '',
            info['color'],
            ''
        ))

    # Cores gerais da UI - Visual clean: branco, cinza, verde, bold
    palette.extend([
        # Headers e estrutura (verde)
        ('header', 'white,bold', 'dark green', '', '#ffffff,bold', '#005f00'),
        ('footer', 'dark gray', '', '', '#6c6c6c', ''),
        ('focus', 'white,bold', '', '', '#ffffff,bold', '#005f00'),

        # Task rows - específico para lista de tasks (mesma cor do header)
        ('task_row', 'white', '', '', '#ffffff', ''),
        ('task_row_focus', 'white,bold', 'dark green', '', '#ffffff,bold', '#005f00'),

        # Botões e dialogs
        ('button', 'white', '', '', '#ffffff', ''),
        ('button_focus', 'black,bold', 'white', '', '#000000,bold', '#ffffff'),
        ('dialog_bg', 'white', 'black', '', '#e4e4e4', '#1c1c1c'),

        # Mensagens
        ('error', 'light red,bold', '', '', '#ff5f5f,bold', ''),
        ('success', 'light green,bold', '', '', '#5fd787,bold', ''),

        # Hierarquia de texto - clean com azul para destaque
        ('title', 'light blue,bold', '', '', '#5fafff,bold', ''),      # Títulos principais (azul)
        ('subtitle', 'light cyan,bold', '', '', '#5fd7ff,bold', ''),   # Subtítulos (azul claro)
        ('text', 'white', '', '', '#ffffff', ''),                      # Texto principal
        ('text_bold', 'white,bold', '', '', '#ffffff,bold', ''),       # Texto com destaque
        ('label', 'dark gray,bold', '', '', '#9e9e9e,bold', ''),       # Labels (ID:, Status:)
        ('secondary', 'dark gray', '', '', '#6c6c6c', ''),             # Info secundária
        ('dimmed', 'dark gray', '', '', '#4e4e4e', ''),                # Texto desabilitado/completo
        ('divider', 'dark gray', '', '', '#3a3a3a', ''),               # Separadores
    ])

    return palette


# ============================================================================
# TaskRow - Widget customizado para exibir uma task
# ============================================================================

class TaskRow(urwid.WidgetWrap):
    """Widget que exibe uma task formatada na lista (versão completa)"""

    def __init__(self, task):
        self.task = task

        # Extrair info da task
        task_id = task['id']
        status = task['status']
        priority = task['priority']
        category = task.get('category', 'other')
        description = task['description']
        who = task.get('who', '')
        company = task.get('company', '')

        # Emojis
        status_emoji = STATUS[status]['emoji']
        priority_emoji = PRIORITY[priority]['emoji']
        category_emoji = CATEGORIES[category]['emoji']

        # Truncar descrição se muito longa
        max_desc_len = 50
        if len(description) > max_desc_len:
            description = description[:max_desc_len-3] + '...'

        # Formatar campos (sempre mostrar colunas para manter alinhamento)
        who_str = f"[{who}]" if who else "[-]"
        company_str = f"🏢{company}" if company else "🏢-"
        clickup_str = "[C]" if task.get('clickup_id') else "   "

        # Montar texto da linha SEM atributos inline - isso permite que o foco funcione
        # Formato: [ID] status pri cat │ Descrição │ Who │ Company │ ClickUp
        line_text = f"#{task_id:<3} {status_emoji} {priority_emoji} {category_emoji} │ {description:<50} │ {who_str:<12} │ {company_str:<15} │ {clickup_str}"

        # Criar widget de texto simples (sem atributos inline)
        text_widget = urwid.Text(line_text)

        # Usar AttrMap - visual clean com branco/cinza, azul quando selecionado
        attr_map = urwid.AttrMap(text_widget, 'task_row', focus_map='task_row_focus')

        super().__init__(attr_map)

    def selectable(self):
        return True

    def keypress(self, size, key):
        return key


class CompactTaskRow(urwid.WidgetWrap):
    """Widget compacto para task - descrição expande para ocupar todo espaço"""

    def __init__(self, task):
        self.task = task

        # Extrair info da task
        task_id = task['id']
        status = task['status']
        priority = task['priority']
        description = task['description']
        company = task.get('company', '')

        # Emojis
        status_emoji = STATUS[status]['emoji']
        priority_emoji = PRIORITY[priority]['emoji']

        # Company truncado
        company_str = company[:12] if company else "-"

        # Usar Columns para layout dinâmico
        # Colunas fixas: ID, status, priority │ [peso: descrição] │ company
        cols = urwid.Columns([
            (12, urwid.Text(f"#{task_id:<3} {status_emoji} {priority_emoji} │")),
            ('weight', 1, urwid.Text(description, wrap='clip')),
            (16, urwid.Text(f"│ 🏢{company_str}")),
        ], dividechars=0)

        attr_map = urwid.AttrMap(cols, 'task_row', focus_map='task_row_focus')
        super().__init__(attr_map)

    def selectable(self):
        return True

    def keypress(self, size, key):
        """Passa as teclas para o handler da tela"""
        return key


# ============================================================================
# FullTasksScreen - Tela cheia de tasks
# ============================================================================

class FullTasksScreen(urwid.WidgetWrap):
    """Tela de tasks em tela cheia (sem painéis laterais)"""

    def __init__(self, app):
        self.app = app

        # Lista de tasks
        self.task_list_walker = urwid.SimpleFocusListWalker([])
        self.task_list = urwid.ListBox(self.task_list_walker)

        # Header
        self.update_header()

        # Footer
        footer_text = urwid.Text(
            "━ [ESC]Voltar [n]New [e]Edit [d]Del [s]Status [f]Finish [m]Metrics [i]ClickUp [0-6]Filtros ━",
            align='center'
        )
        self.footer = urwid.AttrMap(footer_text, 'footer')

        # Frame
        self.frame = urwid.Frame(
            header=self.header,
            body=self.task_list,
            footer=self.footer
        )

        # Popular lista
        self.refresh_task_list()

        super().__init__(self.frame)

    def update_header(self):
        """Atualiza header"""
        total = len(self.app.state.tasks)
        filtered = len(self.app.state.get_filtered_tasks())

        active_filters = []
        if self.app.state.current_filter.get('status'):
            status = self.app.state.current_filter['status']
            active_filters.append(f"{STATUS[status]['label']}")

        filter_str = " • ".join(active_filters) if active_filters else "TODAS"

        header_text = urwid.Text(
            f"━━━ 📋 TASKS ━━━ {filtered}/{total} ━━━ {filter_str} ━━━",
            align='center'
        )
        self.header = urwid.AttrMap(header_text, 'header')

        if hasattr(self, 'frame'):
            self.frame.header = self.header

    def refresh_task_list(self):
        """Recarrega lista de tasks"""
        self.update_header()
        self.task_list_walker.clear()

        tasks = self.app.state.get_filtered_tasks()

        if not tasks:
            self.task_list_walker.append(urwid.Text("📭 Nenhuma task", align='center'))
            return

        priority_order = {'high': 0, 'medium': 1, 'low': 2}

        grouped = {}
        for task in sorted(tasks, key=lambda x: (x['status'], priority_order.get(x.get('priority', 'low'), 2), -x['id'])):
            status = task['status']
            if status not in grouped:
                grouped[status] = []
            grouped[status].append(task)

        status_order = ['blocked', 'doing', 'paused', 'todo', 'done', 'finished']

        for status_key in status_order:
            if status_key not in grouped:
                continue

            status_tasks = grouped[status_key]
            status_info = STATUS[status_key]

            divider_text = urwid.Text(
                ('subtitle', f"\n─── {status_info['emoji']} {status_info['label'].upper()} ({len(status_tasks)}) ───"),
                align='left'
            )
            self.task_list_walker.append(divider_text)

            for task in status_tasks:
                self.task_list_walker.append(TaskRow(task))

        self.task_list_walker.append(urwid.Divider())

    def keypress(self, size, key):
        if key in ('esc', 'q', 't'):
            self.app.pop_screen()
            return None

        if key == 'j':
            key = 'down'
        elif key == 'k':
            key = 'up'

        key = super().keypress(size, key)
        if not key:
            return None

        status_keys = {
            '1': 'todo', '2': 'doing', '3': 'paused',
            '4': 'done', '5': 'blocked', '6': 'finished',
        }

        if key in status_keys:
            self.app.state.current_filter['status'] = status_keys[key]
            if status_keys[key] == 'finished':
                self.app.state.current_filter['show_finished'] = True
            self.refresh_task_list()
            return None
        elif key == '0':
            self.app.state.current_filter = {}
            self.refresh_task_list()
            return None

        focus_widget = self.task_list.focus

        if key == 'enter' and isinstance(focus_widget, TaskRow):
            detail_screen = TaskDetailScreen(self.app, focus_widget.task)
            self.app.push_screen(detail_screen)
            return None

        elif key == 'n':
            edit_screen = TaskEditScreen(self.app, task=None)
            self.app.push_screen(edit_screen)
            return None

        elif key == 'e' and isinstance(focus_widget, TaskRow):
            edit_screen = TaskEditScreen(self.app, focus_widget.task)
            self.app.push_screen(edit_screen)
            return None

        elif key == 's' and isinstance(focus_widget, TaskRow):
            task = focus_widget.task
            def on_close():
                self.app.close_overlay()
                self.refresh_task_list()
            dialog = StatusDialog(self.app, task, on_close)
            self.app.show_overlay(dialog)
            return None

        elif key == 'p' and isinstance(focus_widget, TaskRow):
            task = focus_widget.task
            def on_close():
                self.app.close_overlay()
                self.refresh_task_list()
            dialog = PriorityDialog(self.app, task, on_close)
            self.app.show_overlay(dialog)
            return None

        elif key == 'd' and isinstance(focus_widget, TaskRow):
            task = focus_widget.task
            def on_yes():
                self.app.state.delete_task(task['id'])
                self.app.state.save_tasks()
                self.app.close_overlay()
                self.refresh_task_list()
            def on_no():
                self.app.close_overlay()
            dialog = ConfirmDialog(
                "Confirmar Exclusão",
                f"Deletar task #{task['id']}?",
                on_yes=on_yes,
                on_no=on_no
            )
            self.app.show_overlay(dialog, width=('relative', 50), height=('relative', 25))
            return None

        elif key == 'f':
            # Finalizar tasks done
            done_count = len([t for t in self.app.state.tasks if t['status'] == 'done'])
            if done_count == 0:
                return None
            def on_yes():
                self.app.state.bulk_finish_done_tasks()
                self.app.state.save_tasks()
                self.app.close_overlay()
                self.refresh_task_list()
            def on_no():
                self.app.close_overlay()
            dialog = ConfirmDialog(
                "Finalizar Tasks",
                f"Arquivar {done_count} tasks Concluídas?",
                on_yes=on_yes,
                on_no=on_no
            )
            self.app.show_overlay(dialog, width=('relative', 50), height=('relative', 25))
            return None

        elif key == 'i':
            # Importar do ClickUp
            import_screen = ClickUpImportScreen(self.app)
            self.app.push_screen(import_screen)
            return None

        elif key == 'm':
            # Métricas
            metrics_screen = MetricsScreen(self.app)
            self.app.push_screen(metrics_screen)
            return None

        elif key == 'r':
            # Refresh
            self.refresh_task_list()
            return None

        return key


# ============================================================================
# Dialogs - Overlays para confirmações e inputs
# ============================================================================

class StatusDialog(urwid.WidgetWrap):
    """Dialog para mudar o status de uma task"""

    def __init__(self, app, task, on_close):
        self.app = app
        self.task = task
        self.on_close = on_close

        # RadioButtons para escolher status
        self.status_group = []
        self.status_buttons = {}

        buttons = []
        for status_key, info in STATUS.items():
            rb = urwid.RadioButton(
                self.status_group,
                f"{info['emoji']} {info['label']}",
                state=(status_key == task['status'])
            )
            self.status_buttons[status_key] = rb
            buttons.append(urwid.AttrMap(rb, None, focus_map='focus'))

        # Botões de ação
        ok_btn = urwid.Button("OK", on_press=self.on_ok)
        cancel_btn = urwid.Button("Cancel", on_press=self.on_cancel)

        button_row = urwid.Columns([
            urwid.AttrMap(ok_btn, 'button', focus_map='button_focus'),
            urwid.AttrMap(cancel_btn, 'button', focus_map='button_focus'),
        ], dividechars=2)

        # Montar dialog com ListBox para permitir navegação
        content = [
            urwid.Text(f"Mudar status da task #{task['id']}:\n", align='center'),
            urwid.Divider(),
            *buttons,
            urwid.Divider(),
            button_row,
        ]

        listbox = urwid.ListBox(urwid.SimpleFocusListWalker(content))
        box = urwid.LineBox(listbox, title="Status")
        dialog = urwid.AttrMap(box, 'dialog_bg')

        super().__init__(dialog)

    def on_ok(self, button):
        """Salvar novo status"""
        # Encontrar status selecionado
        for status_key, rb in self.status_buttons.items():
            if rb.get_state():
                self.app.state.update_task(self.task['id'], status=status_key)
                self.app.state.save_tasks()
                break

        self.on_close()

    def on_cancel(self, button):
        """Fechar sem salvar"""
        self.on_close()

    def keypress(self, size, key):
        """Esc para fechar"""
        if key == 'esc':
            self.on_cancel(None)
            return None
        return super().keypress(size, key)


